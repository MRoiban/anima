<layer name="actions" initial="ready"><state name="ready">
<on when="chooseGeneral" to="ready" actions='{"set":{"$selectedTab":0}}'/>
<on when="chooseSound" to="ready" actions='{"set":{"$selectedTab":1}}'/>
<on when="toggleParent" to="ready" actions='{"set":{"$email":"not ($email and $push and $sms)","$push":"not ($email and $push and $sms)","$sms":"not ($email and $push and $sms)"}}'/>
</state></layer>
<listener on="click" target="generalTab" fire="chooseGeneral"/>
<listener on="focus" target="generalTab" fire="chooseGeneral"/>
<listener on="click" target="soundTab" fire="chooseSound"/>
<listener on="focus" target="soundTab" fire="chooseSound"/>
<listener on="click" target="parent" fire="toggleParent"/>
<listener on="key-down" target="parent" key="Enter" fire="toggleParent"/>
<listener on="key-down" target="parent" key=" " fire="toggleParent"/>
<listener on="click" target="emailBox" toggle="$email"/>
<listener on="key-down" target="emailBox" key="Enter" toggle="$email"/>
<listener on="key-down" target="emailBox" key=" " toggle="$email"/>
<listener on="click" target="pushBox" toggle="$push"/>
<listener on="key-down" target="pushBox" key="Enter" toggle="$push"/>
<listener on="key-down" target="pushBox" key=" " toggle="$push"/>
<listener on="click" target="smsBox" toggle="$sms"/>
<listener on="key-down" target="smsBox" key="Enter" toggle="$sms"/>
<listener on="key-down" target="smsBox" key=" " toggle="$sms"/>
<listener on="click" target="muteSwitch" toggle="$muted"/>
<listener on="key-down" target="muteSwitch" key="Enter" toggle="$muted"/>
<listener on="key-down" target="muteSwitch" key=" " toggle="$muted"/>
<listener on="key-down|key-repeat" target="volumeTrack" key="ArrowRight" set="$volume=min(100,$volume+5)"/>
<listener on="key-down|key-repeat" target="volumeTrack" key="ArrowUp" set="$volume=min(100,$volume+5)"/>
<listener on="key-down|key-repeat" target="volumeTrack" key="ArrowLeft" set="$volume=max(0,$volume+-5)"/>
<listener on="key-down|key-repeat" target="volumeTrack" key="ArrowDown" set="$volume=max(0,$volume+-5)"/>
<bind target="generalTab.fill" value="mix(#f0eee6, #d97757, $generalSelected)"/>
<bind target="soundTab.fill" value="mix(#f0eee6, #d97757, $soundSelected)"/>
<bind target="parent.fill" value="mix(#f0eee6, #141413, $allChecked)"/>
<bind target="emailBox.fill" value="mix(#f0eee6, #141413, $email)"/>
<bind target="pushBox.fill" value="mix(#f0eee6, #141413, $push)"/>
<bind target="smsBox.fill" value="mix(#f0eee6, #141413, $sms)"/>
<bind target="generalPanel.visible" value="$generalSelected"/>
<bind target="soundPanel.visible" value="$soundSelected"/>
<bind target="mixedBar.visible" value="$mixed"/>
<bind target="volumeFill.width" value="$volume / 100 * 30"/>
<bind target="muteKnob.x" value="3 * $muted"/>
<bind target="label-generalTitle.visible" value="$generalTitle == &quot;General&quot;"/>
<bind target="label-soundTitle.visible" value="$soundTitle == &quot;Sound&quot;"/>
<bind target="label-notificationsLabel.visible" value="$notificationsLabel == &quot;Notifications&quot; and $generalSelected"/>
<bind target="label-emailLabel.visible" value="$emailLabel == &quot;Email&quot; and $generalSelected"/>
<bind target="label-pushLabel.visible" value="$pushLabel == &quot;Push&quot; and $generalSelected"/>
<bind target="label-smsLabel.visible" value="$smsLabel == &quot;SMS&quot; and $generalSelected"/>
<bind target="label-muteLabel.visible" value="$muteLabel == &quot;Mute&quot; and $soundSelected"/>
</anima>
