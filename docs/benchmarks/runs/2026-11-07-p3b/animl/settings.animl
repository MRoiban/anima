<anima version="0.1" name="settings" grid="40" viewBox="0 0 40 30" requires="data bind derive convert a11y a11yactions focus input">
<model name="Settings">
<number name="volume" default="40" min="0" max="100"/>
<bool name="muted" default="false"/>
<number name="selectedTab" default="0" min="0" max="1"/>
<bool name="email" default="true"/>
<bool name="push" default="false"/>
<bool name="sms" default="false"/>
<string name="generalTitle" default="General"/>
<string name="soundTitle" default="Sound"/>
<string name="notificationsLabel" default="Notifications"/>
<string name="emailLabel" default="Email"/>
<string name="pushLabel" default="Push"/>
<string name="smsLabel" default="SMS"/>
<string name="muteLabel" default="Mute"/>
<bool name="generalSelected" value="$selectedTab == 0"/>
<bool name="soundSelected" value="$selectedTab == 1"/>
<bool name="allChecked" value="$email and $push and $sms"/>
<bool name="anyChecked" value="$email or $push or $sms"/>
<bool name="mixed" value="($email or $push or $sms) and not ($email and $push and $sms)"/>
<string name="volumeSpoken" value="$volume" convert="volumeText"/>
</model>
<instance name="main" model="Settings" default="true" export="true"/>
<converter name="volumeText" type="template" text="Volume {0} %"/>
<trigger name="chooseGeneral"/>
<trigger name="chooseSound"/>
<trigger name="toggleParent"/>
<rect id="background" x0="0" y0="0" width="40" height="30" fill="#f0eee6"/>
<group id="tabs"><a11y role="tab-list" label="Settings"/><focus enabled="false" scope="true" edge="closed-loop"/>
<rect id="generalTab" x0="2" y0="2" width="10" height="3" fill="#f0eee6" stroke="#141413" stroke-width="0.15">
<a11y role="tab" label="$generalTitle" selected="$generalSelected" activate="chooseGeneral"/>
<focus bounds="2 2 10 3"/>
</rect>
<rect id="soundTab" x0="14" y0="2" width="10" height="3" fill="#f0eee6" stroke="#141413" stroke-width="0.15">
<a11y role="tab" label="$soundTitle" selected="$soundSelected" activate="chooseSound"/>
<focus bounds="14 2 10 3"/>
</rect>
</group>
<group id="generalPanel">
<rect id="parent" x0="2" y0="8" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15">
<a11y role="checkbox" label="$notificationsLabel" checked="$allChecked" activate="toggleParent" checked-mixed="$mixed"/>
<focus bounds="2 8 2 2"/>
</rect>
<rect id="emailBox" x0="4" y0="12" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15">
<a11y role="checkbox" label="$emailLabel" checked="$email" activate="$email"/>
<focus bounds="4 12 2 2"/>
</rect>
<rect id="pushBox" x0="4" y0="16" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15">
<a11y role="checkbox" label="$pushLabel" checked="$push" activate="$push"/>
<focus bounds="4 16 2 2"/>
</rect>
<rect id="smsBox" x0="4" y0="20" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15">
<a11y role="checkbox" label="$smsLabel" checked="$sms" activate="$sms"/>
<focus bounds="4 20 2 2"/>
</rect>
<path id="mixedBar" d="M2.4 9L3.6 9" stroke="#141413" stroke-width="0.25"/>
</group>
<group id="soundPanel">
<rect id="volumeTrack" x0="2" y0="10" width="30" height="1" fill="#141413">
<a11y role="slider" label="$volumeSpoken" value="$volume" min="0" max="100" step="5"/>
<focus bounds="2 10 30 1"/>
</rect>
<rect id="volumeFill" x0="2" y0="10" width="12" height="1" fill="#d97757"/>
<rect id="muteSwitch" x0="2" y0="16" width="6" height="3" rx="1.5" fill="#141413">
<a11y role="switch" label="$muteLabel" checked="$muted" activate="$muted"/>
<focus bounds="2 16 6 3"/>
</rect>
<circle id="muteKnob" cx="3.5" cy="17.5" r="1.2" fill="#d97757"/>
</group>
