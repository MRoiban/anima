<anima version="0.1" name="probe" grid="40" viewBox="0 0 40 30" requires="a11y a11yactions data bind focus input">
<model name="Settings"><string name="title" default="General"/><bool name="checked"/><number name="volume" default="40" min="0" max="100"/></model>
<rect id="tab" x0="2" y0="2" width="10" height="3" fill="#d97757">
<a11y role="slider" label="$title" value="$volume" min="0" max="100" step="5"/>
<focus bounds="2 2 10 3"/>
</rect>
</anima>
