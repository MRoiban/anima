      "children": [
        {
          "id": "volumeTrack",
          "type": "rect",
          "x0": 2,
          "y0": 10,
          "w": 30,
          "h": 1,
          "fill": {
            "color": "#141413"
          },
          "a11y": {
            "role": "slider",
