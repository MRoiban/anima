            "value": "$volume",
            "min": 0,
            "max": 100,
            "step": 5
          },
          "focus": {
            "bounds": [2, 10, 30, 1]
          }
        },
        {
          "id": "volumeFill",
          "type": "rect",
          "x0": 2,
          "y0": 10,
          "w": 12,
          "h": 1,
