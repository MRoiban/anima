{
  "anima": "0.1",
  "name": "settings",
  "grid": 40,
  "viewBox": [0, 0, 40, 30],
  "requires": ["data", "bind", "derive", "convert", "a11y", "a11yactions", "focus", "input"],
  "inputs": {
    "chooseGeneral": {
      "type": "trigger"
    },
    "chooseSound": {
      "type": "trigger"
    },
    "toggleParent": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "background",
      "type": "rect",
      "x0": 0,
      "y0": 0,
      "w": 40,
      "h": 30,
      "fill": {
        "color": "#f0eee6"
      }
    },
    {
      "id": "tabs",
      "type": "group",
      "children": [
        {
          "id": "generalTab",
          "type": "rect",
          "x0": 2,
          "y0": 2,
          "w": 10,
          "h": 3,
          "fill": {
            "color": "#f0eee6"
          },
          "stroke": {
            "color": "#141413",
            "width": 0.15
          },
          "a11y": {
            "role": "tab",
            "label": "$generalTitle",
            "activate": "chooseGeneral",
            "selected": "$generalSelected"
          },
          "focus": {
            "bounds": [2, 2, 10, 3]
          }
        },
        {
          "id": "soundTab",
          "type": "rect",
          "x0": 14,
          "y0": 2,
          "w": 10,
          "h": 3,
          "fill": {
            "color": "#f0eee6"
          },
          "stroke": {
            "color": "#141413",
            "width": 0.15
          },
          "a11y": {
            "role": "tab",
            "label": "$soundTitle",
            "activate": "chooseSound",
            "selected": "$soundSelected"
          },
          "focus": {
            "bounds": [14, 2, 10, 3]
          }
        }
      ],
      "a11y": {
        "role": "tab-list",
        "label": "Settings"
      },
      "focus": {
        "enabled": false,
        "scope": true,
        "edge": "closed-loop"
      }
    },
    {
      "id": "generalPanel",
      "type": "group",
      "children": [
        {
          "id": "parent",
          "type": "rect",
          "x0": 2,
          "y0": 8,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#f0eee6"
          },
          "stroke": {
            "color": "#141413",
            "width": 0.15
          },
          "a11y": {
            "role": "checkbox",
            "label": "$notificationsLabel",
            "activate": "toggleParent",
            "checked": "$allChecked",
            "checkedMixed": "$mixed"
          },
          "focus": {
            "bounds": [2, 8, 2, 2]
          }
        },
        {
          "id": "emailBox",
          "type": "rect",
          "x0": 4,
          "y0": 12,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#f0eee6"
          },
          "stroke": {
            "color": "#141413",
            "width": 0.15
          },
          "a11y": {
            "role": "checkbox",
            "label": "$emailLabel",
            "activate": "$email",
            "checked": "$email"
          },
          "focus": {
            "bounds": [4, 12, 2, 2]
          }
        },
        {
          "id": "pushBox",
          "type": "rect",
          "x0": 4,
          "y0": 16,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#f0eee6"
          },
          "stroke": {
            "color": "#141413",
            "width": 0.15
          },
          "a11y": {
            "role": "checkbox",
            "label": "$pushLabel",
            "activate": "$push",
            "checked": "$push"
          },
          "focus": {
            "bounds": [4, 16, 2, 2]
          }
        },
        {
          "id": "smsBox",
          "type": "rect",
          "x0": 4,
          "y0": 20,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#f0eee6"
          },
          "stroke": {
            "color": "#141413",
            "width": 0.15
          },
          "a11y": {
            "role": "checkbox",
            "label": "$smsLabel",
            "activate": "$sms",
            "checked": "$sms"
          },
          "focus": {
            "bounds": [4, 20, 2, 2]
          }
        },
        {
          "id": "mixedBar",
          "type": "path",
          "d": "M2.4 9L3.6 9",
          "stroke": {
            "color": "#141413",
            "width": 0.25
          }
        }
      ]
    },
    {
      "id": "soundPanel",
