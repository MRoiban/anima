  ],
  "machine": {
    "layers": {
      "actions": {
        "initial": "ready",
        "states": {
          "ready": {
            "pose": {},
            "on": [
              {
                "when": "chooseGeneral",
                "to": "ready",
                "actions": {
                  "set": {
                    "$selectedTab": 0
                  }
                }
              },
              {
                "when": "chooseSound",
                "to": "ready",
                "actions": {
                  "set": {
                    "$selectedTab": 1
                  }
                }
              },
              {
                "when": "toggleParent",
                "to": "ready",
                "actions": {
                  "set": {
                    "$email": "not ($email and $push and $sms)",
                    "$push": "not ($email and $push and $sms)",
                    "$sms": "not ($email and $push and $sms)"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "click",
      "target": "generalTab",
      "fire": "chooseGeneral"
    },
    {
      "on": "focus",
      "target": "generalTab",
      "fire": "chooseGeneral"
    },
    {
      "on": "click",
      "target": "soundTab",
      "fire": "chooseSound"
    },
    {
      "on": "focus",
      "target": "soundTab",
      "fire": "chooseSound"
    },
    {
      "on": "click",
      "target": "parent",
      "fire": "toggleParent"
    },
    {
      "on": "key-down",
      "target": "parent",
      "fire": "toggleParent",
      "key": "Enter"
    },
    {
      "on": "key-down",
      "target": "parent",
      "fire": "toggleParent",
      "key": " "
    },
    {
      "on": "click",
      "target": "emailBox",
      "toggle": "$email"
    },
    {
      "on": "key-down",
      "target": "emailBox",
      "toggle": "$email",
      "key": "Enter"
    },
    {
      "on": "key-down",
      "target": "emailBox",
      "toggle": "$email",
      "key": " "
    },
    {
      "on": "click",
      "target": "pushBox",
      "toggle": "$push"
    },
    {
      "on": "key-down",
      "target": "pushBox",
      "toggle": "$push",
      "key": "Enter"
    },
    {
      "on": "key-down",
      "target": "pushBox",
      "toggle": "$push",
      "key": " "
    },
    {
      "on": "click",
      "target": "smsBox",
      "toggle": "$sms"
    },
    {
      "on": "key-down",
      "target": "smsBox",
      "toggle": "$sms",
      "key": "Enter"
    },
    {
      "on": "key-down",
      "target": "smsBox",
      "toggle": "$sms",
      "key": " "
    },
    {
      "on": "click",
      "target": "muteSwitch",
      "toggle": "$muted"
    },
    {
      "on": "key-down",
      "target": "muteSwitch",
      "toggle": "$muted",
      "key": "Enter"
    },
    {
      "on": "key-down",
      "target": "muteSwitch",
      "toggle": "$muted",
      "key": " "
    },
    {
      "on": "key-down|key-repeat",
      "target": "volumeTrack",
      "set": {
        "$volume": "min(100,$volume+5)"
      },
      "key": "ArrowRight"
    },
    {
      "on": "key-down|key-repeat",
      "target": "volumeTrack",
      "set": {
        "$volume": "min(100,$volume+5)"
      },
      "key": "ArrowUp"
    },
    {
      "on": "key-down|key-repeat",
      "target": "volumeTrack",
      "set": {
        "$volume": "max(0,$volume+-5)"
      },
      "key": "ArrowLeft"
    },
    {
      "on": "key-down|key-repeat",
      "target": "volumeTrack",
      "set": {
        "$volume": "max(0,$volume+-5)"
      },
      "key": "ArrowDown"
    }
  ],
  "bind": {
    "generalTab.fill.color": "mix(#f0eee6, #d97757, $generalSelected)",
    "soundTab.fill.color": "mix(#f0eee6, #d97757, $soundSelected)",
    "parent.fill.color": "mix(#f0eee6, #141413, $allChecked)",
    "emailBox.fill.color": "mix(#f0eee6, #141413, $email)",
    "pushBox.fill.color": "mix(#f0eee6, #141413, $push)",
    "smsBox.fill.color": "mix(#f0eee6, #141413, $sms)",
    "generalPanel.visible": "$generalSelected",
    "soundPanel.visible": "$soundSelected",
    "mixedBar.visible": "$mixed",
    "volumeFill.w": "$volume / 100 * 30",
    "muteKnob.x": "3 * $muted",
    "label-generalTitle.visible": "$generalTitle == \"General\"",
    "label-soundTitle.visible": "$soundTitle == \"Sound\"",
    "label-notificationsLabel.visible": "$notificationsLabel == \"Notifications\" and $generalSelected",
    "label-emailLabel.visible": "$emailLabel == \"Email\" and $generalSelected",
    "label-pushLabel.visible": "$pushLabel == \"Push\" and $generalSelected",
    "label-smsLabel.visible": "$smsLabel == \"SMS\" and $generalSelected",
    "label-muteLabel.visible": "$muteLabel == \"Mute\" and $soundSelected"
  },
  "data": {
    "models": {
      "Settings": {
        "properties": {
          "volume": {
            "type": "number",
            "default": 40,
            "min": 0,
            "max": 100
          },
          "muted": {
            "type": "bool",
            "default": false
          },
          "selectedTab": {
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 1
          },
          "email": {
            "type": "bool",
            "default": true
          },
          "push": {
            "type": "bool",
            "default": false
          },
          "sms": {
            "type": "bool",
            "default": false
          },
          "generalTitle": {
            "type": "string",
            "default": "General"
          },
          "soundTitle": {
            "type": "string",
            "default": "Sound"
          },
          "notificationsLabel": {
            "type": "string",
            "default": "Notifications"
          },
          "emailLabel": {
            "type": "string",
            "default": "Email"
          },
          "pushLabel": {
            "type": "string",
            "default": "Push"
          },
          "smsLabel": {
            "type": "string",
            "default": "SMS"
          },
          "muteLabel": {
            "type": "string",
            "default": "Mute"
          },
          "generalSelected": {
            "type": "bool",
            "value": "$selectedTab == 0"
          },
          "soundSelected": {
            "type": "bool",
            "value": "$selectedTab == 1"
          },
          "allChecked": {
            "type": "bool",
            "value": "$email and $push and $sms"
          },
          "anyChecked": {
            "type": "bool",
            "value": "$email or $push or $sms"
          },
          "mixed": {
            "type": "bool",
            "value": "($email or $push or $sms) and not ($email and $push and $sms)"
          },
          "volumeSpoken": {
            "type": "string",
            "value": "$volume",
            "convert": "volumeText"
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Settings",
        "default": true,
        "exported": true,
        "values": {}
      }
    }
  },
  "converters": {
    "volumeText": {
      "type": "template",
      "text": "Volume {0} %"
    }
  }
}
