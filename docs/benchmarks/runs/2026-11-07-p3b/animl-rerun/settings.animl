    </group>
    <group id="mute">
      <a11y role="switch" label="$muteTitle" checked="$muted" bounds="2 16 6 3"/>
      <rect id="muteTrack" x0="2" y0="16" width="6" height="3" rx="1.5" fill="#141413"/>
      <circle id="muteKnob" cx="3.5" cy="17.5" r="1.2" fill="#f0eee6"/>

