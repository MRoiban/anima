  ],
  "machine": {
    "layers": {
      "actions": {
        "initial": "ready",
        "states": {
          "ready": {
            "pose": {},
            "on": [
              {
                "when": "selectGeneral",
                "to": "ready",
                "actions": {
                  "set": {
                    "$selectedTab": "\"general\""
                  }
                }
              },
              {
                "when": "selectSound",
                "to": "ready",
                "actions": {
                  "set": {
                    "$selectedTab": "\"sound\""
                  }
                }
              },
              {
                "when": "toggleAll",
                "to": "ready",
                "actions": {
                  "set": {
                    "$email": "not ($email and $push and $sms)",
                    "$push": "not ($email and $push and $sms)",
                    "$sms": "not ($email and $push and $sms)"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "focus",
      "target": "generalTab",
      "set": {
        "$selectedTab": "\"general\""
      }
    },
    {
      "on": "focus",
      "target": "soundTab",
      "set": {
        "$selectedTab": "\"sound\""
      }
    },
    {
      "on": "click",
      "target": "generalTab",
      "fire": "selectGeneral"
    },
    {
      "on": "click",
      "target": "soundTab",
      "fire": "selectSound"
    },
    {
      "on": "click",
      "target": "notifications",
      "fire": "toggleAll"
    },
    {
      "on": "click",
      "target": "email",
      "toggle": "$email"
    },
    {
      "on": "click",
      "target": "push",
      "toggle": "$push"
    },
    {
      "on": "click",
      "target": "sms",
      "toggle": "$sms"
    },
    {
      "on": "click",
      "target": "mute",
      "toggle": "$muted"
    }
  ],
  "bind": {
    "generalPanel.visible": "$generalSelected",
    "soundPanel.visible": "$soundSelected",
    "generalTabShape.fill.color": "mix(#f0eee6, #d97757, $generalSelected)",
    "soundTabShape.fill.color": "mix(#f0eee6, #d97757, $soundSelected)",
    "mixedBar.visible": "$someChecked",
    "volumeFill.w": "$volume / 100 * 30",
    "muteKnob.x": "$muted * 3",
    "muteTrack.fill.color": "mix(#141413, #d97757, $muted)",
    "notificationsFill.visible": "$allChecked",
    "emailFill.visible": "$email",
    "pushFill.visible": "$push",
    "smsFill.visible": "$sms"
  },
  "data": {
    "models": {
      "Settings": {
        "properties": {
          "volume": {
            "type": "number",
            "default": 40,
            "min": 0,
            "max": 100
          },
          "muted": {
            "type": "bool",
            "default": false
          },
          "selectedTab": {
            "type": "enum",
            "default": "general",
            "values": ["general", "sound"]
          },
          "email": {
            "type": "bool",
            "default": true
          },
          "push": {
            "type": "bool",
            "default": false
          },
          "sms": {
            "type": "bool",
            "default": false
          },
          "generalTitle": {
            "type": "string",
            "default": "General"
          },
          "soundTitle": {
            "type": "string",
            "default": "Sound"
          },
          "notificationsTitle": {
            "type": "string",
            "default": "Notifications"
          },
          "emailTitle": {
            "type": "string",
            "default": "Email"
          },
          "pushTitle": {
            "type": "string",
            "default": "Push"
          },
          "smsTitle": {
            "type": "string",
            "default": "SMS"
          },
          "volumeTitle": {
            "type": "string",
            "default": "Volume"
          },
          "muteTitle": {
            "type": "string",
            "default": "Mute"
          },
          "generalSelected": {
            "type": "bool",
            "value": "$selectedTab == \"general\""
          },
          "soundSelected": {
            "type": "bool",
            "value": "$selectedTab == \"sound\""
          },
          "allChecked": {
            "type": "bool",
            "value": "$email and $push and $sms"
          },
          "someChecked": {
            "type": "bool",
            "value": "($email or $push or $sms) and not ($email and $push and $sms)"
          },
          "volumeText": {
            "type": "string",
            "value": "$volume",
            "convert": "spokenVolume"
          }
        }
      }
    },
    "instances": {
      "settings": {
        "model": "Settings",
        "default": true,
        "values": {}
      }
    }
  },
  "converters": {
    "spokenVolume": {
      "type": "template",
      "text": "Volume {0} %"
    }
  }
}
