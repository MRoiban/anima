<anima version="0.1" name="search-card" grid="40" viewBox="0 0 40 30" requires="text texteffects textinput focus a11y input data bind derive convert">
  <model name="Search">
    <string name="query"/>
    <string name="label0" default="Notifications"/>
    <bool name="shown0" default="true"/>
    <number name="n0" value="$shown0"/>
    <string name="label1" default="Network and connectivity preferences"/>
    <bool name="shown1" default="true"/>
    <number name="n1" value="$shown1"/>
    <string name="label2" default="Sound"/>
    <bool name="shown2" default="true"/>
    <number name="n2" value="$shown2"/>
    <string name="label3" default="Display brightness and colour"/>
    <bool name="shown3" default="true"/>
    <number name="n3" value="$shown3"/>
    <string name="label4" default="Privacy"/>
    <bool name="shown4" default="true"/>
    <number name="n4" value="$shown4"/>
    <number name="count" value="$n0 + $n1 + $n2 + $n3 + $n4"/>
    <string name="countText" value="$count" convert="resultCount"/>
  </model>
  <instance name="main" model="Search" default="true" export="true"/>
  <converter name="resultCount" type="template" text="{0} results"/>
  <text-style id="body" font="sans-serif" size="1.8" line-height="1" fill="#141413"/>
  <text-style id="muted" font="sans-serif" size="1.8" line-height="1" fill="#777670"/>
  <text-style id="heading" font="sans-serif" size="2.5" line-height="1" fill="#141413"/>
  <rect id="panel" x0="0" y0="0" width="40" height="30" fill="#f0eee6"/>
  <text id="title" x="2" y="2"><run text="Find a setting" style="heading"/><text-effect y="1" opacity="0" start="0" end="20" falloff="3" units="glyphs"/></text>
  <rect id="fieldBox" x0="2" y0="6" width="36" height="4" rx="0.7" stroke="#141413" stroke-width="0.12"/>
  <text id="search" x="2.8" y="7.1" width="34.4" height="2.5" sizing="fixed" wrap="false"><run text="" style="body"/><text-input label="Search" write-text="$query" caret-color="#d97757" selection-color="#d9775755"/></text>
  <text id="placeholder" x="2.8" y="7.1" pointerEnabled="false"><run text="Search" style="muted"/><a11y role="none"/></text>
  <bind target="placeholder.visible" value="$query == &quot;&quot;"/>
  <text id="row0" x="2" y="12" width="14" height="2.5" sizing="fixed" wrap="false" overflow="ellipsis"><run text="$label0" style="body"/><a11y role="text" label="$label0"/></text>
  <bind target="row0.collapsed" value="not $shown0"/>
  <text id="row1" x="2" y="15" width="14" height="2.5" sizing="fixed" wrap="false" overflow="ellipsis"><run text="$label1" style="body"/><a11y role="text" label="$label1"/></text>
  <bind target="row1.collapsed" value="not $shown1"/>
  <text id="row2" x="2" y="18" width="14" height="2.5" sizing="fixed" wrap="false" overflow="ellipsis"><run text="$label2" style="body"/><a11y role="text" label="$label2"/></text>
  <bind target="row2.collapsed" value="not $shown2"/>
  <text id="row3" x="2" y="21" width="14" height="2.5" sizing="fixed" wrap="false" overflow="ellipsis"><run text="$label3" style="body"/><a11y role="text" label="$label3"/></text>
  <bind target="row3.collapsed" value="not $shown3"/>
  <text id="row4" x="2" y="24" width="14" height="2.5" sizing="fixed" wrap="false" overflow="ellipsis"><run text="$label4" style="body"/><a11y role="text" label="$label4"/></text>
  <bind target="row4.collapsed" value="not $shown4"/>
  <text id="countLine" x="2" y="27"><run text="$countText" style="body"/><a11y role="status" label="$countText"/></text>
  <timeline name="wave" duration="1.1" reducedMotion="end"><track target="title.effects.0.start">0 0; 1.1 17</track></timeline>
  <layer name="intro" initial="enter"><state name="enter" play="wave"/></layer>
</anima>
