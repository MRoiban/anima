<anima version="0.1" name="settings-card" grid="40" viewBox="0 0 40 30" requires="data bind derive convert a11y a11yactions focus">
  <model name="Settings">
    <number name="volume" default="40" min="0" max="100"/>
    <bool name="muted"/>
    <number name="selectedTab" default="0" min="0" max="1"/>
    <bool name="email" default="true"/>
    <bool name="push"/>
    <bool name="sms"/>
    <string name="generalTitle" default="General"/>
    <string name="soundTitle" default="Sound"/>
    <string name="notificationsLabel" default="Notifications"/>
    <string name="emailLabel" default="Email"/>
    <string name="pushLabel" default="Push"/>
    <string name="smsLabel" default="SMS"/>
    <string name="volumeLabel" default="Volume"/>
    <string name="muteLabel" default="Mute"/>
    <string name="tabsLabel" default="Settings"/>
    <bool name="generalSelected" value="$selectedTab == 0"/>
    <bool name="soundSelected" value="$selectedTab == 1"/>
    <bool name="allNotifications" value="$email and $push and $sms"/>
    <bool name="someNotifications" value="($email or $push or $sms) and not ($email and $push and $sms)"/>
    <string name="volumeText" value="$volume" convert="spokenVolume"/>
  </model>
  <instance name="settings" model="Settings" default="true" export="true"/>
  <converter name="spokenVolume" type="template" text="Volume {0} %"/>
  <trigger name="chooseGeneral"/>
  <trigger name="chooseSound"/>
  <trigger name="toggleNotifications"/>
  <rect id="panel" x0="0" y0="0" width="40" height="30" fill="#f0eee6"/>
  <group id="tabs">
    <a11y role="tab-list" label="$tabsLabel"/>
    <group id="general">
      <a11y role="tab" label="$generalTitle" activate="chooseGeneral" selected="$generalSelected" bounds="2 2 10 3"/>
      <rect id="generalShape" x0="2" y0="2" width="10" height="3" fill="#f0eee6" stroke="#141413" stroke-width="0.15"/>
      <path id="generalText"
          d="M3.46 3.09L3.27 2.9L2.89 2.9L2.7 3.09L2.7 3.85L2.89 4.04L3.46 4.04L3.46 3.47L3.08 3.47M4.6 2.9L3.84 2.9L3.84 4.04L4.6 4.04M3.84 3.47L4.41 3.47M4.98 4.04L4.98 2.9L5.74 4.04L5.74 2.9M6.88 2.9L6.12 2.9L6.12 4.04L6.88 4.04M6.12 3.47L6.69 3.47M7.26 4.04L7.26 2.9L7.83 2.9L8.02 3.09L8.02 3.28L7.83 3.47L7.26 3.47M7.64 3.47L8.02 4.04M8.4 4.04L8.4 3.28L8.78 2.9L9.16 3.28L9.16 4.04M8.4 3.47L9.16 3.47M9.54 2.9L9.54 4.04L10.3 4.04"
          stroke="#141413" stroke-width="0.12"/>
    </group>
    <group id="sound">
      <a11y role="tab" label="$soundTitle" activate="chooseSound" selected="$soundSelected" bounds="14 2 10 3"/>
      <rect id="soundShape" x0="14" y0="2" width="10" height="3" fill="#f0eee6" stroke="#141413" stroke-width="0.15"/>
      <path id="soundText"
          d="M15.46 2.9L14.89 2.9L14.7 3.09L14.7 3.28L14.89 3.47L15.27 3.47L15.46 3.66L15.46 3.85L15.27 4.04L14.7 4.04M16.03 2.9L16.41 2.9L16.6 3.09L16.6 3.85L16.41 4.04L16.03 4.04L15.84 3.85L15.84 3.09L16.03 2.9M16.98 2.9L16.98 3.85L17.17 4.04L17.55 4.04L17.74 3.85L17.74 2.9M18.12 4.04L18.12 2.9L18.88 4.04L18.88 2.9M19.26 2.9L19.64 2.9L20.02 3.28L20.02 3.66L19.64 4.04L19.26 4.04L19.26 2.9"
          stroke="#141413" stroke-width="0.12"/>
    </group>
  </group>
  <group id="generalPanel">
    <group id="notifications">
      <a11y role="checkbox" label="$notificationsLabel" activate="toggleNotifications" checked="$allNotifications" checked-mixed="$someNotifications" bounds="2 8 2 2"/>
      <rect id="notificationsOutline" x0="2" y0="8" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15"/>
      <rect id="notificationsFill" x0="2" y0="8" width="2" height="2" fill="#141413"/>
      <path id="notificationsText"
          d="M5 9.54L5 8.4L5.76 9.54L5.76 8.4M6.33 8.4L6.71 8.4L6.9 8.59L6.9 9.35L6.71 9.54L6.33 9.54L6.14 9.35L6.14 8.59L6.33 8.4M7.28 8.4L8.04 8.4M7.66 8.4L7.66 9.54M8.42 8.4L9.18 8.4M8.8 8.4L8.8 9.54M8.42 9.54L9.18 9.54M10.32 8.4L9.56 8.4L9.56 9.54M9.56 8.97L10.13 8.97M10.7 8.4L11.46 8.4M11.08 8.4L11.08 9.54M10.7 9.54L11.46 9.54M12.6 8.4L12.03 8.4L11.84 8.59L11.84 9.35L12.03 9.54L12.6 9.54M12.98 9.54L12.98 8.78L13.36 8.4L13.74 8.78L13.74 9.54M12.98 8.97L13.74 8.97M14.12 8.4L14.88 8.4M14.5 8.4L14.5 9.54M15.26 8.4L16.02 8.4M15.64 8.4L15.64 9.54M15.26 9.54L16.02 9.54M16.59 8.4L16.97 8.4L17.16 8.59L17.16 9.35L16.97 9.54L16.59 9.54L16.4 9.35L16.4 8.59L16.59 8.4M17.54 9.54L17.54 8.4L18.3 9.54L18.3 8.4M19.44 8.4L18.87 8.4L18.68 8.59L18.68 8.78L18.87 8.97L19.25 8.97L19.44 9.16L19.44 9.35L19.25 9.54L18.68 9.54"
          stroke="#141413" stroke-width="0.12"/>
    </group>
    <rect id="mixedBar" x0="2.4" y0="8.85" width="1.2" height="0.3" fill="#141413"/>
    <group id="email">
      <a11y role="checkbox" label="$emailLabel" checked="$email" bounds="4 12 2 2"/>
      <rect id="emailOutline" x0="4" y0="12" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15"/>
      <rect id="emailFill" x0="4" y0="12" width="2" height="2" fill="#141413"/>
      <path id="emailText"
          d="M7.76 12.4L7 12.4L7 13.54L7.76 13.54M7 12.97L7.57 12.97M8.14 13.54L8.14 12.4L8.52 12.97L8.9 12.4L8.9 13.54M9.28 13.54L9.28 12.78L9.66 12.4L10.04 12.78L10.04 13.54M9.28 12.97L10.04 12.97M10.42 12.4L11.18 12.4M10.8 12.4L10.8 13.54M10.42 13.54L11.18 13.54M11.56 12.4L11.56 13.54L12.32 13.54"
          stroke="#141413" stroke-width="0.12"/>
    </group>
    <group id="push">
      <a11y role="checkbox" label="$pushLabel" checked="$push" bounds="4 16 2 2"/>
      <rect id="pushOutline" x0="4" y0="16" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15"/>
      <rect id="pushFill" x0="4" y0="16" width="2" height="2" fill="#141413"/>
      <path id="pushText"
          d="M7 17.54L7 16.4L7.57 16.4L7.76 16.59L7.76 16.78L7.57 16.97L7 16.97M8.14 16.4L8.14 17.35L8.33 17.54L8.71 17.54L8.9 17.35L8.9 16.4M10.04 16.4L9.47 16.4L9.28 16.59L9.28 16.78L9.47 16.97L9.85 16.97L10.04 17.16L10.04 17.35L9.85 17.54L9.28 17.54M10.42 16.4L10.42 17.54M11.18 16.4L11.18 17.54M10.42 16.97L11.18 16.97"
          stroke="#141413" stroke-width="0.12"/>
    </group>
    <group id="sms">
      <a11y role="checkbox" label="$smsLabel" checked="$sms" bounds="4 20 2 2"/>
      <rect id="smsOutline" x0="4" y0="20" width="2" height="2" fill="#f0eee6" stroke="#141413" stroke-width="0.15"/>
      <rect id="smsFill" x0="4" y0="20" width="2" height="2" fill="#141413"/>
      <path id="smsText"
          d="M7.76 20.4L7.19 20.4L7 20.59L7 20.78L7.19 20.97L7.57 20.97L7.76 21.16L7.76 21.35L7.57 21.54L7 21.54M8.14 21.54L8.14 20.4L8.52 20.97L8.9 20.4L8.9 21.54M10.04 20.4L9.47 20.4L9.28 20.59L9.28 20.78L9.47 20.97L9.85 20.97L10.04 21.16L10.04 21.35L9.85 21.54L9.28 21.54"
          stroke="#141413" stroke-width="0.12"/>
    </group>
  </group>
  <group id="soundPanel">
    <group id="volume">
      <a11y role="slider" label="$volumeLabel" value="$volume" value-text="$volumeText" min="0" max="100" step="5" bounds="2 9 30 3"/>
      <rect id="volumeTrack" x0="2" y0="10" width="30" height="1" fill="#141413"/>
      <rect id="volumeFill" x0="2" y0="10" width="12" height="1" fill="#d97757"/>
      <path id="volumeText"
          d="M2 7.4L2.38 8.54L2.76 7.4M3.33 7.4L3.71 7.4L3.9 7.59L3.9 8.35L3.71 8.54L3.33 8.54L3.14 8.35L3.14 7.59L3.33 7.4M4.28 7.4L4.28 8.54L5.04 8.54M5.42 7.4L5.42 8.35L5.61 8.54L5.99 8.54L6.18 8.35L6.18 7.4M6.56 8.54L6.56 7.4L6.94 7.97L7.32 7.4L7.32 8.54M8.46 7.4L7.7 7.4L7.7 8.54L8.46 8.54M7.7 7.97L8.27 7.97"
          stroke="#141413" stroke-width="0.12"/>
    </group>
    <group id="mute">
      <a11y role="switch" label="$muteLabel" checked="$muted" bounds="2 16 6 3"/>
      <rect id="muteTrack" x0="2" y0="16" width="6" height="3" rx="1.5" fill="#141413"/>
      <circle id="muteKnob" cx="3.5" cy="17.5" r="1.2" fill="#f0eee6"/>
      <path id="muteText"
          d="M9 18.04L9 16.9L9.38 17.47L9.76 16.9L9.76 18.04M10.14 16.9L10.14 17.85L10.33 18.04L10.71 18.04L10.9 17.85L10.9 16.9M11.28 16.9L12.04 16.9M11.66 16.9L11.66 18.04M13.18 16.9L12.42 16.9L12.42 18.04L13.18 18.04M12.42 17.47L12.99 17.47"
          stroke="#141413" stroke-width="0.12"/>
    </group>
  </group>
  <bind target="generalPanel.visible" value="$generalSelected"/>
  <bind target="soundPanel.visible" value="$soundSelected"/>
  <bind target="generalShape.fill" value="mix(#f0eee6, #d97757, $generalSelected)"/>
  <bind target="soundShape.fill" value="mix(#f0eee6, #d97757, $soundSelected)"/>
  <bind target="volumeFill.width" value="$volume / 100 * 30"/>
  <bind target="muteKnob.x" value="$muted * 3"/>
  <bind target="muteTrack.fill" value="mix(#141413, #d97757, $muted)"/>
  <bind target="mixedBar.visible" value="$someNotifications"/>
  <bind target="notificationsFill.visible" value="$allNotifications"/>
  <bind target="emailFill.visible" value="$email"/>
  <bind target="pushFill.visible" value="$push"/>
  <bind target="smsFill.visible" value="$sms"/>
  <layer name="actions" initial="ready">
    <state name="ready">
      <on when="chooseGeneral" to="ready" actions="{&quot;set&quot;:{&quot;$selectedTab&quot;:0}}"/>
      <on when="chooseSound" to="ready" actions="{&quot;set&quot;:{&quot;$selectedTab&quot;:1}}"/>
      <on when="toggleNotifications" to="ready"
          actions="{&quot;set&quot;:{&quot;$email&quot;:&quot;not ($email and $push and $sms)&quot;,&quot;$push&quot;:&quot;not ($email and $push and $sms)&quot;,&quot;$sms&quot;:&quot;not ($email and $push and $sms)&quot;}}"/>
    </state>
  </layer>
  <listener on="focus" target="general" set="$selectedTab=0"/>
  <listener on="click" target="general" fire="chooseGeneral"/>
  <listener on="focus" target="sound" set="$selectedTab=1"/>
  <listener on="click" target="sound" fire="chooseSound"/>
  <listener on="click" target="notifications" fire="toggleNotifications"/>
  <listener on="click" target="email" toggle="$email"/>
  <listener on="click" target="push" toggle="$push"/>
  <listener on="click" target="sms" toggle="$sms"/>
  <listener on="click" target="mute" toggle="$muted"/>
</anima>
