{
  "anima": "0.1",
  "name": "reaching-arm",
  "grid": 40,
  "viewBox": [0, 0, 40, 30],
  "requires": ["input", "bind", "rig", "ik", "skin"],
  "inputs": {
    "pointerX": {
      "type": "number",
      "default": 25
    },
    "pointerY": {
      "type": "number",
      "default": 20
    },
    "hover": {
      "type": "bool",
      "default": false
    }
  },
  "nodes": [
    {
      "id": "panel",
      "type": "rect",
      "x0": 0,
      "y0": 0,
      "w": 40,
      "h": 30,
      "fill": {
        "color": "#f0eee6"
      }
    },
    {
      "id": "pointer-target",
      "type": "group",
      "x": 25,
      "y": 20,
      "children": []
    },
    {
      "id": "aim",
      "type": "group",
      "x": 25,
      "y": 20,
      "children": [],
      "constraints": [
        {
          "kind": "copyPosition",
          "strength": 0,
          "from": "pointer-target"
        }
      ]
    },
    {
      "id": "eye-center",
      "type": "group",
      "x": 32,
      "y": 6,
      "children": []
    },
    {
      "id": "eye-ring",
      "type": "circle",
      "center": [32, 6],
      "r": 2,
      "stroke": {
        "color": "#141413",
        "width": 0.3
      }
    },
    {
      "id": "pupil",
      "type": "circle",
      "center": [32, 6],
      "r": 0.6,
      "pivot": [32, 6],
      "fill": {
        "color": "#141413"
      },
      "constraints": [
        {
          "kind": "copyPosition",
          "strength": 0,
          "from": "pointer-target"
        },
        {
          "kind": "keepDistance",
          "to": "eye-center",
          "distance": 1,
          "mode": "within"
        }
      ]
    },
    {
      "id": "upper",
      "type": "bone",
      "x": 8,
      "y": 20,
      "children": [
        {
          "id": "fore",
          "type": "bone",
          "children": [
            {
              "id": "hand",
              "type": "circle",
              "center": [25, 20],
              "r": 1.2,
              "pivot": [25, 20],
              "fill": {
                "color": "#141413"
              }
            }
          ],
          "length": 8,
          "constraints": [
            {
              "kind": "ik",
              "target": "aim",
              "bones": 2,
              "bend": "cw"
            }
          ]
        }
      ],
      "root": true,
      "length": 9
    },
    {
      "id": "sleeve",
      "type": "path",
      "d": "M8 19 L16 19 L17 19 L18 19 L25 19 L25 21 L18 21 L17 21 L16 21 L8 21 Z",
      "fill": {
        "color": "#d97757"
      },
      "skin": {
        "bones": ["upper", "fore"],
        "weights": [
          {
            "point": {
              "upper": 1
            }
          },
          {
            "point": {
              "upper": 1
            }
          },
          {
            "point": {
              "upper": 0.75,
              "fore": 0.25
            }
          },
          {
            "point": {
              "upper": 0.25,
              "fore": 0.75
            }
          },
          {
            "point": {
              "fore": 1
            }
          },
          {
            "point": {
              "fore": 1
            }
          },
          {
            "point": {
              "upper": 0.25,
              "fore": 0.75
            }
          },
          {
            "point": {
              "upper": 0.75,
              "fore": 0.25
            }
          },
          {
            "point": {
              "upper": 1
            }
          },
          {
            "point": {
              "upper": 1
            }
          }
        ]
      }
    }
  ],
  "timelines": {
    "release": {
      "duration": 0.4,
      "loop": "once",
      "tracks": {
        "aim.constraints.0.strength": [
          [0, 1],
          [0.4, 0]
        ],
        "pupil.constraints.0.strength": [
          [0, 1],
          [0.4, 0]
        ],
        "aim.y": [
          [0, 20],
          [0.1, 24],
          [0.2, 20],
          [0.4, 20]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "tracking": {
        "initial": "rest",
        "states": {
          "rest": {
            "pose": {
              "aim.constraints.0.strength": 0,
              "pupil.constraints.0.strength": 0
            },
            "on": [
              {
                "when": "hover",
                "to": "reach",
                "blend": 0
              }
            ]
          },
          "reach": {
            "pose": {
              "aim.constraints.0.strength": 1,
              "pupil.constraints.0.strength": 1
            },
            "on": [
              {
                "when": "!hover",
                "to": "release",
                "blend": 0
              }
            ]
          },
          "release": {
            "play": "release",
            "on": [
              {
                "when": "hover",
                "to": "reach",
                "blend": 0
              },
              {
                "when": "@end",
                "to": "rest",
                "blend": 0
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "enter",
      "set": {
        "hover": true
      }
    },
    {
      "on": "move",
      "set": {},
      "write": {
        "x": "pointerX",
        "y": "pointerY"
      }
    },
    {
      "on": "leave",
      "set": {
        "hover": false
      }
    }
  ],
  "bind": {
    "pointer-target.x": "pointerX",
    "pointer-target.y": "pointerY"
  }
}
