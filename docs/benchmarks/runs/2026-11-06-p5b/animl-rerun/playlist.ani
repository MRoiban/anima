{
  "anima": "0.1",
  "name": "playlist",
  "grid": 40,
  "viewBox": [0, 0, 40, 30],
  "requires": ["paint", "assets", "components", "data", "bind", "derive", "lists", "events"],
  "nodes": [
    {
      "id": "panel",
      "type": "rect",
      "x0": 0,
      "y0": 0,
      "w": 40,
      "h": 30,
      "fill": {
        "color": "#f0eee6"
      }
    },
    {
      "id": "rows",
      "type": "repeat",
      "y": 2,
      "list": "$tracks",
      "component": "row",
      "dy": 6,
      "size": [36, 5]
    },
    {
      "id": "count",
      "type": "repeat",
      "count": "$tracks.length",
      "component": "dot",
      "dy": -1.2
    }
  ],
  "components": {
    "row": {
      "grid": 40,
      "viewBox": [0, 0, 36, 5],
      "inputs": {
        "tap": {
          "type": "trigger"
        },
        "visits": {
          "type": "number",
          "default": 0
        }
      },
      "hit": {
        "rect": [0, 0, 36, 5]
      },
      "nodes": [
        {
          "id": "outline",
          "type": "rect",
          "x0": 1,
          "y0": -0.2,
          "w": 33,
          "h": 4.4,
          "opacity": 0,
          "stroke": {
            "color": "#d97757",
            "width": 0.3
          }
        },
        {
          "id": "dawn-cover",
          "type": "image",
          "x0": 2,
          "y0": 0,
          "visible": false,
          "asset": "dawn",
          "sampling": "nearest",
          "width": 4,
          "height": 4
        },
        {
          "id": "tide-cover",
          "type": "image",
          "x0": 2,
          "y0": 0,
          "visible": false,
          "asset": "tide",
          "sampling": "nearest",
          "width": 4,
          "height": 4
        },
        {
          "id": "ember-cover",
          "type": "image",
          "x0": 2,
          "y0": 0,
          "visible": false,
          "asset": "ember",
          "sampling": "nearest",
          "width": 4,
          "height": 4
        },
        {
          "id": "title",
          "type": "rect",
          "x0": 8,
          "y0": 0.5,
          "w": 1,
          "h": 1,
          "fill": {
            "color": "#141413"
          }
        },
        {
          "id": "duration",
          "type": "rect",
          "x0": 8,
          "y0": 2.5,
          "w": 1,
          "h": 1,
          "fill": {
            "color": "#d97757"
          }
        }
      ],
      "machine": {
        "layers": {
          "cover": {
            "initial": "choose",
            "states": {
              "choose": {
                "pose": {},
                "on": [
                  {
                    "when": "$cover == asset(\"dawn\")",
                    "to": "dawn"
                  },
                  {
                    "when": "$cover == asset(\"tide\")",
                    "to": "tide"
                  },
                  {
                    "when": "$cover == asset(\"ember\")",
                    "to": "ember"
                  }
                ]
              },
              "dawn": {
                "pose": {
                  "dawn-cover.visible": true
                },
                "on": [
                  {
                    "when": "$cover != asset(\"dawn\")",
                    "to": "choose"
                  }
                ]
              },
              "tide": {
                "pose": {
                  "tide-cover.visible": true
                },
                "on": [
                  {
                    "when": "$cover != asset(\"tide\")",
                    "to": "choose"
                  }
                ]
              },
              "ember": {
                "pose": {
                  "ember-cover.visible": true
                },
                "on": [
                  {
                    "when": "$cover != asset(\"ember\")",
                    "to": "choose"
                  }
                ]
              }
            }
          },
          "playback": {
            "initial": "idle",
            "states": {
              "idle": {
                "pose": {},
                "on": [
                  {
                    "when": "tap && $clip == asset(\"dawn-clip\")",
                    "to": "dawn"
                  },
                  {
                    "when": "tap && $clip == asset(\"tide-clip\")",
                    "to": "tide"
                  },
                  {
                    "when": "tap && $clip == asset(\"ember-clip\")",
                    "to": "ember"
                  }
                ]
              },
              "dawn": {
                "pose": {},
                "emit": "play-dawn",
                "on": [
                  {
                    "when": "@after(0)",
                    "to": "idle"
                  }
                ]
              },
              "tide": {
                "pose": {},
                "emit": "play-tide",
                "on": [
                  {
                    "when": "@after(0)",
                    "to": "idle"
                  }
                ]
              },
              "ember": {
                "pose": {},
                "emit": "play-ember",
                "on": [
                  {
                    "when": "@after(0)",
                    "to": "idle"
                  }
                ]
              }
            }
          }
        }
      },
      "listeners": [
        {
          "on": "click",
          "fire": "tap",
          "set": {
            "$main:selected": "$uid",
            "visits": "visits+1"
          }
        }
      ],
      "bind": {
        "title.w": "$title.length",
        "duration.w": "$duration / 10",
        "outline.opacity": "$main:selected == $uid"
      },
      "eventDefs": {
        "play-dawn": {
          "payload": {
            "uid": {
              "type": "number",
              "value": "{$uid}"
            }
          },
          "audio": "dawn-clip"
        },
        "play-tide": {
          "payload": {
            "uid": {
              "type": "number",
              "value": "{$uid}"
            }
          },
          "audio": "tide-clip"
        },
        "play-ember": {
          "payload": {
            "uid": {
              "type": "number",
              "value": "{$uid}"
            }
          },
          "audio": "ember-clip"
        }
      },
      "data": "Track"
    },
    "dot": {
      "grid": 1,
      "nodes": [
        {
          "id": "disc",
          "type": "circle",
          "center": [38, 28],
          "r": 0.4,
          "fill": {
            "color": "#141413"
          }
        }
      ],
      "bind": {
        "disc.r": "0.4"
      }
    }
  },
  "assets": {
    "dawn": {
      "type": "image",
      "source": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADED76LAAAAJUlEQVR4nGO4WR7+X0RE+P+Hd8/+Y2Mz4JMEsRnwSYLYDEPBCgD3z6GazqLReAAAAABJRU5ErkJggg==",
      "storage": "embedded",
      "size": 94,
      "mime": "image/png"
    },
    "tide": {
      "type": "image",
      "source": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADED76LAAAAJUlEQVR4nGMQERH+/+Hds/83y8P/Y2Mz4JMEsRnwSYLYDEPBCgA2vqQj2qEragAAAABJRU5ErkJggg==",
      "storage": "embedded",
      "size": 94,
      "mime": "image/png"
    },
    "ember": {
      "type": "image",
      "source": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAYAAADED76LAAAAJUlEQVR4nGP48O7Z/5vl4f9FRIT/Y2Mz4JMEsRnwSYLYDEPBCgB/UaMGJP5pqQAAAABJRU5ErkJggg==",
      "storage": "embedded",
      "size": 94,
      "mime": "image/png"
    },
    "dawn-clip": {
      "type": "audio",
      "source": "data:audio/wav;base64,",
      "storage": "embedded",
      "size": 19244,
      "mime": "audio/wav",
      "duration": 1.2,
      "start": 0.2,
      "end": 1
    },
    "tide-clip": {
      "type": "audio",
      "source": "data:audio/wav;base64,",
      "storage": "embedded",
      "size": 19244,
      "mime": "audio/wav",
      "duration": 1.2,
      "start": 0.2,
      "end": 1
    },
    "ember-clip": {
      "type": "audio",
      "source": "data:audio/wav;base64,",
      "storage": "embedded",
      "size": 19244,
      "mime": "audio/wav",
      "duration": 1.2,
      "start": 0.2,
      "end": 1
    }
  },
  "data": {
    "models": {
      "Track": {
        "properties": {
          "uid": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "cover": {
            "type": "asset-ref",
            "assetType": "image"
          },
          "clip": {
            "type": "asset-ref",
            "assetType": "audio"
          }
        }
      },
      "Playlist": {
        "properties": {
          "selected": {
            "type": "number",
            "default": -1
          },
          "tracks": {
            "type": "list",
            "of": "Track"
          }
        },
        "global": true
      }
    },
    "instances": {
      "main": {
        "model": "Playlist",
        "default": true,
        "values": {
          "tracks": [
            {
              "uid": 1,
              "title": "Dawn",
              "duration": 90,
              "cover": "dawn",
              "clip": "dawn-clip"
            },
            {
              "uid": 2,
              "title": "Tide",
              "duration": 150,
              "cover": "tide",
              "clip": "tide-clip"
            },
            {
              "uid": 3,
              "title": "Ember",
              "duration": 60,
              "cover": "ember",
              "clip": "ember-clip"
            }
          ]
        }
      }
    }
  }
}
