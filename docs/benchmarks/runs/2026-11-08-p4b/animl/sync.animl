<anima version="0.1" name="sync" title="Sync" grid="20" requires="motion">
  <color name="ink" value="#141413"/>
  <color name="accent" value="#d97757"/>
  <bool name="syncing"/>
  <bool name="hover"/>
  <number name="phase" min="0" max="1" default="0"/>
  <a11y role="button" label="Sync" activate="syncing" pressed="syncing"/>
  <hit rect="0 0 20 20"/>
  <group id="peek" pivot="10 10">
    <group id="arrows" pivot="10 10">
      <arc id="top" cx="10" cy="10" r="6" from="-165" to="-15"
           stroke="ink" stroke-width="1.5" stroke-linecap="round"/>
      <path id="top-tip" d="M14.064 7.447L15.796 8.447L16.796 6.715"
            stroke="ink" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <arc id="bottom" cx="10" cy="10" r="6" from="15" to="165"
           stroke="ink" stroke-width="1.5" stroke-linecap="round"/>
      <path id="bottom-tip" d="M5.936 12.553L4.204 11.553L3.204 13.285"
            stroke="ink" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </group>
  </group>
  <path id="check" d="M7 10L9.2 12.2L13 8" pivot="10 10" scale="0"
        stroke="accent" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <timeline name="turn" duration="1.2" loop="loop" quantize="10" reducedMotion="skip">
    <track target="arrows.rotate">0 0; 1.2 360</track>
  </timeline>
  <timeline name="pop" duration="0.6" reducedMotion="end">
    <track target="check.scale">0 0 elastic(1, 0.3); 0.6 1</track>
  </timeline>
  <!-- One peek definition; symmetric pose crossfades approximate timeline reversal.
       A leave keeps the current scale, but uses a fresh 0.4 s blend duration. -->
  <timeline name="peek-motion" duration="0.4" reducedMotion="end">
    <track target="peek.scale">0 1; 0.4 1.1</track>
  </timeline>
  <layer name="hover" initial="rest">
    <state name="rest">
      <pose peek.scale="1"/>
      <on when="hover" to="peek" blend="0.4"/>
    </state>
    <state name="peek">
      <pose peek.scale="1.1"/>
      <on when="!hover" to="rest" blend="0.4"/>
    </state>
  </layer>
  <listener on="enter" set="hover=true"/>
  <listener on="leave" set="hover=false"/>

  <!-- Quantized idle scrub. Adjacent transitions chain, so arbitrary phase jumps
       resolve in at most 12 hops. Stop returns to phase immediately: no step-finish gate. -->
  <layer name="rotation" initial="q0">
    <state name="q0">
      <pose arrows.rotate="0"/>
      <on when="syncing" to="spin"/>
      <on when="phase &gt;= 0.08333333333333333" to="q1"/>
    </state>
    <state name="q1">
      <pose arrows.rotate="30"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.08333333333333333" to="q0"/>
      <on when="phase &gt;= 0.16666666666666666" to="q2"/>
    </state>
    <state name="q2">
      <pose arrows.rotate="60"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.16666666666666666" to="q1"/>
      <on when="phase &gt;= 0.25" to="q3"/>
    </state>
    <state name="q3">
      <pose arrows.rotate="90"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.25" to="q2"/>
      <on when="phase &gt;= 0.3333333333333333" to="q4"/>
    </state>
    <state name="q4">
      <pose arrows.rotate="120"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.3333333333333333" to="q3"/>
      <on when="phase &gt;= 0.4166666666666667" to="q5"/>
    </state>
    <state name="q5">
      <pose arrows.rotate="150"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.4166666666666667" to="q4"/>
      <on when="phase &gt;= 0.5" to="q6"/>
    </state>
    <state name="q6">
      <pose arrows.rotate="180"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.5" to="q5"/>
      <on when="phase &gt;= 0.5833333333333334" to="q7"/>
    </state>
    <state name="q7">
      <pose arrows.rotate="210"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.5833333333333334" to="q6"/>
      <on when="phase &gt;= 0.6666666666666666" to="q8"/>
    </state>
    <state name="q8">
      <pose arrows.rotate="240"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.6666666666666666" to="q7"/>
      <on when="phase &gt;= 0.75" to="q9"/>
    </state>
    <state name="q9">
      <pose arrows.rotate="270"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.75" to="q8"/>
      <on when="phase &gt;= 0.8333333333333334" to="q10"/>
    </state>
    <state name="q10">
      <pose arrows.rotate="300"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.8333333333333334" to="q9"/>
      <on when="phase &gt;= 0.9166666666666666" to="q11"/>
    </state>
    <state name="q11">
      <pose arrows.rotate="330"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 0.9166666666666666" to="q10"/>
      <on when="phase &gt;= 1" to="q12"/>
    </state>
    <state name="q12">
      <pose arrows.rotate="360"/>
      <on when="syncing" to="spin"/>
      <on when="phase &lt; 1" to="q11"/>
    </state>
    <state name="spin" play="turn">
      <on when="!syncing" to="q0"/>
    </state>
  </layer>
  <layer name="completion" initial="idle">
    <state name="idle">
      <pose check.scale="0"/>
      <on when="syncing" to="running"/>
    </state>
    <state name="running">
      <pose check.scale="0"/>
      <on when="!syncing" to="done"/>
    </state>
    <state name="done" play="pop">
      <on when="syncing" to="running"/>
    </state>
  </layer>
</anima>
