{
  "anima": "0.1",
  "name": "sync",
  "title": "Sync",
  "grid": 20,
  "requires": ["motion"],
  "colors": {
    "ink": "#141413",
    "accent": "#d97757"
  },
  "a11y": {
    "role": "button",
    "label": "Sync",
    "activate": "syncing",
    "pressed": "syncing"
  },
  "inputs": {
    "syncing": {
      "type": "bool"
    },
    "hover": {
      "type": "bool"
    },
    "phase": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 1
    }
  },
  "hit": {
    "rect": [0, 0, 20, 20]
  },
  "nodes": [
    {
      "id": "peek",
      "type": "group",
      "pivot": [10, 10],
      "children": [
        {
          "id": "arrows",
          "type": "group",
          "pivot": [10, 10],
          "children": [
            {
              "id": "top",
              "type": "arc",
              "center": [10, 10],
              "r": 6,
              "from": -165,
              "to": -15,
              "stroke": {
                "color": "ink",
                "width": 1.5,
                "cap": "round"
              }
            },
            {
              "id": "top-tip",
              "type": "path",
              "d": "M14.064 7.447L15.796 8.447L16.796 6.715",
              "stroke": {
                "color": "ink",
                "width": 1.5,
                "cap": "round",
                "join": "round"
              }
            },
            {
              "id": "bottom",
              "type": "arc",
              "center": [10, 10],
              "r": 6,
              "from": 15,
              "to": 165,
              "stroke": {
                "color": "ink",
                "width": 1.5,
                "cap": "round"
              }
            },
            {
              "id": "bottom-tip",
              "type": "path",
              "d": "M5.936 12.553L4.204 11.553L3.204 13.285",
              "stroke": {
                "color": "ink",
                "width": 1.5,
                "cap": "round",
                "join": "round"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "check",
      "type": "path",
      "d": "M7 10L9.2 12.2L13 8",
      "pivot": [10, 10],
      "scale": 0,
      "stroke": {
        "color": "accent",
        "width": 1.5,
        "cap": "round",
        "join": "round"
      }
    }
  ],
  "timelines": {
    "turn": {
      "duration": 1.2,
      "loop": "loop",
      "reducedMotion": "skip",
      "tracks": {
        "arrows.rotate": [
          [0, 0],
          [1.2, 360]
        ]
      },
      "quantize": 10
    },
    "pop": {
      "duration": 0.6,
      "reducedMotion": "end",
      "tracks": {
        "check.scale": [
          [0, 0, "elastic(1, 0.3)"],
          [0.6, 1]
        ]
      }
    },
    "peek-motion": {
      "duration": 0.4,
      "reducedMotion": "end",
      "tracks": {
        "peek.scale": [
          [0, 1],
          [0.4, 1.1]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "hover": {
        "initial": "rest",
        "states": {
          "rest": {
            "pose": {
              "peek.scale": 1
            },
            "on": [
              {
                "when": "hover",
                "to": "peek",
                "blend": 0.4
              }
            ]
          },
          "peek": {
            "pose": {
              "peek.scale": 1.1
            },
            "on": [
              {
                "when": "!hover",
                "to": "rest",
                "blend": 0.4
              }
            ]
          }
        }
      },
      "rotation": {
        "initial": "q0",
        "states": {
          "q0": {
            "pose": {
              "arrows.rotate": 0
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase >= 0.08333333333333333",
                "to": "q1"
              }
            ]
          },
          "q1": {
            "pose": {
              "arrows.rotate": 30
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.08333333333333333",
                "to": "q0"
              },
              {
                "when": "phase >= 0.16666666666666666",
                "to": "q2"
              }
            ]
          },
          "q2": {
            "pose": {
              "arrows.rotate": 60
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.16666666666666666",
                "to": "q1"
              },
              {
                "when": "phase >= 0.25",
                "to": "q3"
              }
            ]
          },
          "q3": {
            "pose": {
              "arrows.rotate": 90
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.25",
                "to": "q2"
              },
              {
                "when": "phase >= 0.3333333333333333",
                "to": "q4"
              }
            ]
          },
          "q4": {
            "pose": {
              "arrows.rotate": 120
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.3333333333333333",
                "to": "q3"
              },
              {
                "when": "phase >= 0.4166666666666667",
                "to": "q5"
              }
            ]
          },
          "q5": {
            "pose": {
              "arrows.rotate": 150
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.4166666666666667",
                "to": "q4"
              },
              {
                "when": "phase >= 0.5",
                "to": "q6"
              }
            ]
          },
          "q6": {
            "pose": {
              "arrows.rotate": 180
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.5",
                "to": "q5"
              },
              {
                "when": "phase >= 0.5833333333333334",
                "to": "q7"
              }
            ]
          },
          "q7": {
            "pose": {
              "arrows.rotate": 210
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.5833333333333334",
                "to": "q6"
              },
              {
                "when": "phase >= 0.6666666666666666",
                "to": "q8"
              }
            ]
          },
          "q8": {
            "pose": {
              "arrows.rotate": 240
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.6666666666666666",
                "to": "q7"
              },
              {
                "when": "phase >= 0.75",
                "to": "q9"
              }
            ]
          },
          "q9": {
            "pose": {
              "arrows.rotate": 270
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.75",
                "to": "q8"
              },
              {
                "when": "phase >= 0.8333333333333334",
                "to": "q10"
              }
            ]
          },
          "q10": {
            "pose": {
              "arrows.rotate": 300
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.8333333333333334",
                "to": "q9"
              },
              {
                "when": "phase >= 0.9166666666666666",
                "to": "q11"
              }
            ]
          },
          "q11": {
            "pose": {
              "arrows.rotate": 330
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 0.9166666666666666",
                "to": "q10"
              },
              {
                "when": "phase >= 1",
                "to": "q12"
              }
            ]
          },
          "q12": {
            "pose": {
              "arrows.rotate": 360
            },
            "on": [
              {
                "when": "syncing",
                "to": "spin"
              },
              {
                "when": "phase < 1",
                "to": "q11"
              }
            ]
          },
          "spin": {
            "play": "turn",
            "on": [
              {
                "when": "!syncing",
                "to": "q0"
              }
            ]
          }
        }
      },
      "completion": {
        "initial": "idle",
        "states": {
          "idle": {
            "pose": {
              "check.scale": 0
            },
            "on": [
              {
                "when": "syncing",
                "to": "running"
              }
            ]
          },
          "running": {
            "pose": {
              "check.scale": 0
            },
            "on": [
              {
                "when": "!syncing",
                "to": "done"
              }
            ]
          },
          "done": {
            "play": "pop",
            "on": [
              {
                "when": "syncing",
                "to": "running"
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "enter",
      "set": {
        "hover": true
      }
    },
    {
      "on": "leave",
      "set": {
        "hover": false
      }
    }
  ]
}
