advance 1
screenshot evidence/final-default.png
data-dump evidence/final-default.json
# Each wave should fade linearly over its own third.
data volume=0
advance 15
screenshot evidence/blend-000.png
data volume=0.165
advance 15
screenshot evidence/blend-0165.png
data volume=0.33
advance 15
screenshot evidence/blend-033.png
data volume=0.495
advance 15
screenshot evidence/blend-0495.png
data volume=0.66
advance 15
screenshot evidence/blend-066.png
data volume=0.83
advance 15
screenshot evidence/blend-083.png
data volume=1
advance 15
screenshot evidence/blend-100.png
# Mute and restore all three waves at the same current volume.
pointer click@60,72
advance 1
screenshot evidence/final-muted.png
data-dump evidence/final-muted.json
pointer click@60,72
advance 1
screenshot evidence/final-unmuted.png
data-dump evidence/final-unmuted.json
# Settle a decrease, then two successive increases and a decrease.
data volume=0.2
advance 15
screenshot evidence/pulse-rest.png
data volume=0.4
advance 3
screenshot evidence/pulse-a-f3.png
advance 3
screenshot evidence/pulse-a-f6.png
advance 6
screenshot evidence/pulse-a-f12.png
advance 1
screenshot evidence/pulse-a-f13.png
data volume=0.6
advance 6
screenshot evidence/pulse-b-f6.png
advance 7
screenshot evidence/pulse-b-f13.png
data volume=0.4
advance 6
screenshot evidence/pulse-decrease-f6.png
data-dump evidence/pulse-decrease.json
# Off-centre grab with vertical displacement, then both clamp endpoints.
data volume=0.5
advance 15
pointer down@300,72
pointer move@372,110
advance 1
screenshot evidence/final-drag-offset.png
data-dump evidence/final-drag-offset.json
pointer move@600,110
advance 1
screenshot evidence/final-drag-max.png
data-dump evidence/final-drag-max.json
pointer move@0,110
advance 1
screenshot evidence/final-drag-min.png
data-dump evidence/final-drag-min.json
pointer up@0,110
key right
advance 15
screenshot evidence/final-key-right.png
data-dump evidence/final-key-right.json
key left
advance 15
screenshot evidence/final-key-left.png
data-dump evidence/final-key-left.json
key left
advance 1
data-dump evidence/final-key-min.json
data volume=1
advance 15
key right
advance 1
data-dump evidence/final-key-max.json
semantics evidence/final-semantics.json
quit
