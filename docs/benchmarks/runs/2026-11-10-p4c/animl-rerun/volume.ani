{
  "anima": "0.1",
  "name": "volume",
  "grid": 40,
  "viewBox": [0, 0, 40, 12],
  "requires": ["bind", "input", "focus", "machine"],
  "colors": {
    "ink": "#141413",
    "accent": "#d97757"
  },
  "inputs": {
    "volume": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    "muted": {
      "type": "bool",
      "default": false
    }
  },
  "nodes": [
    {
      "id": "speaker",
      "type": "group",
      "pivot": [5, 6],
      "children": [
        {
          "id": "body",
          "type": "rect",
          "x0": 2,
          "y0": 4,
          "w": 3,
          "h": 4,
          "fill": {
            "color": "ink"
          }
        },
        {
          "id": "cone",
          "type": "path",
          "d": "M5 4 L8 2 L8 10 L5 8 Z",
          "fill": {
            "color": "ink"
          }
        },
        {
          "id": "slash",
          "type": "path",
          "d": "M1 2 L9 10",
          "opacity": 0,
          "stroke": {
            "color": "accent",
            "width": 1
          }
        }
      ]
    },
    {
      "id": "waves",
      "type": "group",
      "children": [
        {
          "id": "wave1",
          "type": "arc",
          "center": [8, 6],
          "r": 2,
          "from": -45,
          "to": 45,
          "stroke": {
            "color": "ink",
            "width": 1
          }
        },
        {
          "id": "wave2",
          "type": "arc",
          "center": [8, 6],
          "r": 3.5,
          "from": -45,
          "to": 45,
          "stroke": {
            "color": "ink",
            "width": 1
          }
        },
        {
          "id": "wave3",
          "type": "arc",
          "center": [8, 6],
          "r": 5,
          "from": -45,
          "to": 45,
          "stroke": {
            "color": "ink",
            "width": 1
          }
        }
      ]
    },
    {
      "id": "track",
      "type": "path",
      "d": "M12 6 L36 6",
      "stroke": {
        "color": "ink",
        "width": 1
      }
    },
    {
      "id": "fill",
      "type": "path",
      "d": "M12 6 L36 6",
      "stroke": {
        "color": "accent",
        "width": 1,
        "trimEnd": 0.5
      }
    },
    {
      "id": "rail",
      "type": "group",
      "x": 12,
      "y": 6,
      "scaleX": 24,
      "children": [
        {
          "id": "knob",
          "type": "circle",
          "center": [0, 0],
          "r": 1.5,
          "x": 0.5,
          "scaleX": 0.041666666666666664,
          "fill": {
            "color": "accent"
          },
          "cursor": "resize-horizontal",
          "focus": {
            "label": "Volume",
            "bounds": [-1.5, -1.5, 3, 3]
          }
        }
      ]
    }
  ],
  "timelines": {
    "silent": {
      "duration": 1,
      "tracks": {
        "wave1.opacity": [
          [0, 0],
          [1, 0]
        ],
        "wave2.opacity": [
          [0, 0],
          [1, 0]
        ],
        "wave3.opacity": [
          [0, 0],
          [1, 0]
        ]
      }
    },
    "low": {
      "duration": 1,
      "tracks": {
        "wave1.opacity": [
          [0, 1],
          [1, 1]
        ],
        "wave2.opacity": [
          [0, 0],
          [1, 0]
        ],
        "wave3.opacity": [
          [0, 0],
          [1, 0]
        ]
      }
    },
    "medium": {
      "duration": 1,
      "tracks": {
        "wave1.opacity": [
          [0, 1],
          [1, 1]
        ],
        "wave2.opacity": [
          [0, 1],
          [1, 1]
        ],
        "wave3.opacity": [
          [0, 0],
          [1, 0]
        ]
      }
    },
    "loud": {
      "duration": 1,
      "tracks": {
        "wave1.opacity": [
          [0, 1],
          [1, 1]
        ],
        "wave2.opacity": [
          [0, 1],
          [1, 1]
        ],
        "wave3.opacity": [
          [0, 1],
          [1, 1]
        ]
      }
    },
    "pulse": {
      "duration": 0.2,
      "tracks": {
        "speaker.scale": [
          [0, 1],
          [0.1, 1.08],
          [0.2, 1]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "blend": {
        "initial": "level",
        "states": {
          "level": {
            "play": "silent",
            "mix": {
              "mode": "1d",
              "axis": "volume",
              "children": [
                {
                  "play": "silent",
                  "at": 0
                },
                {
                  "play": "low",
                  "at": 0.33
                },
                {
                  "play": "medium",
                  "at": 0.66
                },
                {
                  "play": "loud",
                  "at": 1
                }
              ]
            }
          }
        }
      },
      "feedback": {
        "initial": "idle",
        "states": {
          "any": {
            "pose": {},
            "on": [
              {
                "when": "@after(0)",
                "to": "pulse",
                "change": {
                  "input": "volume",
                  "mode": "increased"
                }
              }
            ],
            "kind": "any"
          },
          "idle": {
            "pose": {
              "speaker.scale": 1
            }
          },
          "pulse": {
            "play": "pulse",
            "on": [
              {
                "when": "@end",
                "to": "idle"
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "drag-start|drag|drag-end",
      "target": "knob",
      "set": {},
      "write": {
        "x": "volume"
      },
      "align": "preserve"
    },
    {
      "on": "key-down|key-repeat",
      "target": "knob",
      "set": {
        "volume": "volume - 0.1"
      },
      "key": "ArrowLeft"
    },
    {
      "on": "key-down|key-repeat",
      "target": "knob",
      "set": {
        "volume": "volume+0.1"
      },
      "key": "ArrowRight"
    },
    {
      "on": "click",
      "target": "speaker",
      "toggle": "muted"
    }
  ],
  "bind": {
    "knob.x": "volume",
    "fill.stroke.trimEnd": "volume",
    "waves.opacity": "1 - muted",
    "slash.opacity": "muted"
  }
}
