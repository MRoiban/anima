{
  "$comment": "Literal-only listener writes limit the counter to ten; the milestone cycle is unbounded.",
  "anima": "0.1",
  "name": "share",
  "grid": 20,
  "requires": ["events", "assets"],
  "colors": {
    "ink": "#141413",
    "accent": "#d97757"
  },
  "a11y": {
    "role": "button",
    "label": "Share",
    "activate": "clicked"
  },
  "inputs": {
    "count": {
      "type": "number",
      "default": 0
    },
    "clicked": {
      "type": "trigger"
    },
    "pulse": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "links",
      "type": "path",
      "d": "M5 10L15 5M5 10L15 15",
      "stroke": {
        "color": "ink",
        "width": 1.5
      }
    },
    {
      "id": "left",
      "type": "circle",
      "center": [5, 10],
      "r": 2,
      "pivot": [5, 10],
      "fill": {
        "color": "ink"
      }
    },
    {
      "id": "upper",
      "type": "circle",
      "center": [15, 5],
      "r": 2,
      "pivot": [15, 5],
      "fill": {
        "color": "ink"
      }
    },
    {
      "id": "lower",
      "type": "circle",
      "center": [15, 15],
      "r": 2,
      "pivot": [15, 15],
      "fill": {
        "color": "ink"
      }
    }
  ],
  "timelines": {
    "pulse": {
      "duration": 0.4,
      "loop": "once",
      "tracks": {
        "left.scale": [
          [0, 1],
          [0.15, 1.3],
          [0.3, 1],
          [0.4, 1]
        ],
        "upper.scale": [
          [0, 1],
          [0.05, 1],
          [0.2, 1.3],
          [0.35, 1],
          [0.4, 1]
        ],
        "lower.scale": [
          [0, 1],
          [0.1, 1],
          [0.25, 1.3],
          [0.4, 1]
        ]
      },
      "events": [
        [0, "shared"],
        [0.4, "pulse-done"]
      ]
    }
  },
  "machine": {
    "layers": {
      "motion": {
        "initial": "rest",
        "states": {
          "rest": {
            "pose": {},
            "on": [
              {
                "when": "pulse",
                "to": "playing"
              }
            ]
          },
          "playing": {
            "play": "pulse",
            "on": [
              {
                "when": "pulse",
                "to": "playing"
              },
              {
                "when": "@end",
                "to": "rest"
              }
            ]
          }
        }
      },
      "counter": {
        "initial": "zero",
        "states": {
          "zero": {
            "pose": {},
            "on": [
              {
                "when": "clicked",
                "to": "one"
              }
            ]
          },
          "one": {
            "pose": {},
            "emit": "count-one",
            "on": [
              {
                "when": "clicked",
                "to": "two"
              }
            ]
          },
          "two": {
            "pose": {},
            "emit": "count-two",
            "on": [
              {
                "when": "clicked",
                "to": "three"
              }
            ]
          },
          "three": {
            "pose": {},
            "emit": "count-three",
            "on": [
              {
                "when": "clicked",
                "to": "four"
              }
            ]
          },
          "four": {
            "pose": {},
            "emit": "count-four",
            "on": [
              {
                "when": "clicked",
                "to": "five"
              }
            ]
          },
          "five": {
            "pose": {},
            "emit": "count-five",
            "on": [
              {
                "when": "clicked",
                "to": "six"
              }
            ]
          },
          "six": {
            "pose": {},
            "emit": "count-six",
            "on": [
              {
                "when": "clicked",
                "to": "seven"
              }
            ]
          },
          "seven": {
            "pose": {},
            "emit": "count-seven",
            "on": [
              {
                "when": "clicked",
                "to": "eight"
              }
            ]
          },
          "eight": {
            "pose": {},
            "emit": "count-eight",
            "on": [
              {
                "when": "clicked",
                "to": "nine"
              }
            ]
          },
          "nine": {
            "pose": {},
            "emit": "count-nine",
            "on": [
              {
                "when": "clicked",
                "to": "ten"
              }
            ]
          },
          "ten": {
            "pose": {},
            "emit": "count-ten",
            "on": [
              {
                "when": "clicked",
                "to": "ten"
              }
            ]
          }
        }
      },
      "fifths": {
        "initial": "zero",
        "states": {
          "zero": {
            "pose": {},
            "on": [
              {
                "when": "clicked",
                "to": "one"
              }
            ]
          },
          "one": {
            "pose": {},
            "on": [
              {
                "when": "clicked",
                "to": "two"
              }
            ]
          },
          "two": {
            "pose": {},
            "on": [
              {
                "when": "clicked",
                "to": "three"
              }
            ]
          },
          "three": {
            "pose": {},
            "on": [
              {
                "when": "clicked",
                "to": "four"
              }
            ]
          },
          "four": {
            "pose": {},
            "on": [
              {
                "when": "clicked",
                "to": "fifth"
              }
            ]
          },
          "fifth": {
            "pose": {},
            "emit": "milestone",
            "on": [
              {
                "when": "clicked",
                "to": "one"
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "click",
      "fire": "clicked"
    },
    {
      "on": "event:count-one",
      "fire": "pulse",
      "set": {
        "count": 1
      }
    },
    {
      "on": "event:count-two",
      "fire": "pulse",
      "set": {
        "count": 2
      }
    },
    {
      "on": "event:count-three",
      "fire": "pulse",
      "set": {
        "count": 3
      }
    },
    {
      "on": "event:count-four",
      "fire": "pulse",
      "set": {
        "count": 4
      }
    },
    {
      "on": "event:count-five",
      "fire": "pulse",
      "set": {
        "count": 5
      }
    },
    {
      "on": "event:count-six",
      "fire": "pulse",
      "set": {
        "count": 6
      }
    },
    {
      "on": "event:count-seven",
      "fire": "pulse",
      "set": {
        "count": 7
      }
    },
    {
      "on": "event:count-eight",
      "fire": "pulse",
      "set": {
        "count": 8
      }
    },
    {
      "on": "event:count-nine",
      "fire": "pulse",
      "set": {
        "count": 9
      }
    },
    {
      "on": "event:count-ten",
      "fire": "pulse",
      "set": {
        "count": 10
      }
    }
  ],
  "assets": {
    "tone": {
      "type": "audio",
      "source": "data:audio/wav;base64,",
      "storage": "embedded"
    }
  },
  "eventDefs": {
    "shared": {
      "payload": {
        "count": {
          "type": "number",
          "input": "count"
        },
        "channel": {
          "type": "string",
          "value": "button"
        }
      },
      "audio": "tone"
    },
    "milestone": {
      "url": "https://example.org/thanks",
      "target": "_blank"
    }
  }
}
