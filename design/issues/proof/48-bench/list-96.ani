{
  "anima": "0.1",
  "name": "issue-48-list-large",
  "grid": 100,
  "requires": [
    "components",
    "data",
    "bind",
    "lists"
  ],
  "nodes": [
    {
      "id": "pulse",
      "type": "rect",
      "opacity": 0,
      "fill": {
        "color": "#000000"
      },
      "x0": 0,
      "y0": 0,
      "w": 1,
      "h": 1
    },
    {
      "id": "points",
      "type": "repeat",
      "list": "$items",
      "component": "slot",
      "size": [
        3,
        3
      ]
    }
  ],
  "components": {
    "slot": {
      "grid": 3,
      "nodes": [
        {
          "id": "segment",
          "type": "rect",
          "fill": {
            "color": "#222222"
          },
          "x0": 0,
          "y0": 1,
          "w": 2,
          "h": 0.25
        },
        {
          "id": "dot",
          "type": "circle",
          "center": [
            2,
            1
          ],
          "r": 0.35,
          "fill": {
            "color": "#555555"
          }
        }
      ],
      "bind": {
        "segment.x": "$x",
        "segment.y": "$y",
        "dot.x": "$x",
        "dot.y": "$y",
        "dot.scale": "$scale"
      },
      "data": "Point"
    }
  },
  "data": {
    "models": {
      "Point": {
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "scale": {
            "type": "number",
            "default": 1
          }
        }
      },
      "Chart": {
        "properties": {
          "items": {
            "type": "list",
            "of": "Point"
          }
        }
      }
    },
