{
  "name": "anima-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/web",
    "packages/cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/core/test && tsc -p packages/web && tsc -p packages/web/test && tsc -p packages/cli && tsc -p tools",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node tools/size.ts",
    "gen": "node tools/gen-schema.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run size && node tools/build-web.ts --check",
    "build:web": "node tools/build-web.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
