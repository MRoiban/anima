{
  "anima": "0.1",
  "name": "oracle-data",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 8,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "number"
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Root",
        "default": true,
        "values": {
          "value": 3
        }
      },
      "other": {
        "model": "Root",
        "values": {
          "value": 8
        }
      }
    }
  }
}
