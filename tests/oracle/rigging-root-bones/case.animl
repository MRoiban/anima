<anima version="0.1" name="rigging-root-bones" grid="20" requires="rig">
  <bone id="outer" length="5" x="4" y="12">
    <bone id="inner" root="true" length="2" x="10" y="12">
      <rect id="hand" x0="11.5" y0="11.5" width="1" height="1" fill="#d97757"/>
    </bone>
  </bone>
  <timeline name="go" duration="1">
    <track target="outer.rotate">
      0  0
      1  -60
    </track>
    <track target="inner.rotate">
      0  0
      1  30
    </track>
  </timeline>
  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
