<anima version="0.1" name="converter-probe" grid="20" requires="data bind convert">
  <model name="Root">
    <string name="value" default="&quot;2.3000&quot;"/>
  </model>
  <converter name="cv" type="remove-zeros"/>
  <circle id="dot" cx="10" cy="10" properties="{&quot;result&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;default&quot;:&quot;&quot;}}" r="1" fill="#000"/>
  <bind target="dot.properties.result" value="$value" convert="cv"/>
</anima>
