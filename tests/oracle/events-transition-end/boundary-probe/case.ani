{
  "anima": "0.1",
  "name": "events-oracle",
  "grid": 20,
  "requires": ["events"],
  "nodes": [
    {
      "id": "a",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "timelines": {
    "t": {
      "duration": 1,
      "tracks": {}
    }
  },
  "machine": {
    "layers": {
      "main": {
        "initial": "s",
        "states": {
          "s": {
            "play": "t",
            "on": [
              {
                "when": "@after(0.5)",
                "to": "end",
                "blend": 0.25,
                "startEmit": "begin",
                "endEmit": "done"
              }
            ],
            "endEmit": "exit"
          },
          "end": {
            "pose": {}
          }
        }
      }
    }
  }
}
