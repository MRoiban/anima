{
  "anima": "0.1",
  "name": "oracle-data",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      },
      "properties": {
        "custom": {
          "type": "string",
          "default": "Ada"
        }
      }
    }
  ],
  "bind": {
    "dot.properties.custom": {
      "value": "$value",
      "mode": "to-source"
    }
  },
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "string",
            "default": ""
          }
        }
      }
    }
  }
}
