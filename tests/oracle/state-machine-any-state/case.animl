<anima version="0.1" name="oracle" grid="20" requires="machine"><number name="level" default="25"/><rect id="dot" x0="2" y0="8" width="2" height="4" fill="#4263eb"/><timeline name="t0" duration="2"><track target="dot.x">0 0;2 8</track></timeline><timeline name="t1" duration="2"><track target="dot.x">0 8;2 8</track></timeline><timeline name="t2" duration="2"><track target="dot.x">0 4;2 4</track></timeline><layer name="l" initial="a"><state name="all" kind="any"><on when="level > 10" to="b" /></state><state name="a" play="t0"/><state name="b" play="t1"/></layer></anima>
