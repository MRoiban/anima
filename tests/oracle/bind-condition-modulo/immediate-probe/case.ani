{
  "anima": "0.1",
  "name": "bind-condition-modulo",
  "grid": 20,
  "requires": ["bind", "events"],
  "inputs": {
    "count": {
      "type": "number"
    },
    "tap": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 2,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "machine": {
    "layers": {
      "main": {
        "initial": "idle",
        "states": {
          "idle": {
            "pose": {},
            "on": [
              {
                "when": "tap && count > 0 && mod(count, 5) == 0",
                "to": "milestone"
              }
            ]
          },
          "milestone": {
            "pose": {},
            "emit": "shared",
            "on": [
              {
                "when": "@after(0)",
                "to": "idle"
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "click",
      "fire": "tap",
      "set": {
        "count": "count+1"
      }
    }
  ],
  "eventDefs": {
    "shared": {
      "payload": {
        "count": {
          "type": "number",
          "value": "{count}"
        }
      }
    }
  }
}
