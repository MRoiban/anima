<anima version="0.1" name="rigging-distance-exact" grid="20" requires="rig">
  <group id="target" x="5" y="10"/>
  <group id="inside" x="6" y="10">
    <keep-distance to="target" distance="2" mode="exact"/>
    <circle id="insideArt" cx="0" cy="0" r="0.5" fill="#d97757"/>
  </group>
  <group id="ring" x="8" y="10">
    <keep-distance to="target" distance="2" mode="exact"/>
    <circle id="ringArt" cx="0" cy="0" r="0.5" fill="#d97757"/>
  </group>
  <group id="outside" x="11" y="10">
    <keep-distance to="target" distance="2" mode="exact"/>
    <circle id="outsideArt" cx="0" cy="0" r="0.5" fill="#d97757"/>
  </group>
  <timeline name="go" duration="1">
    <track target="inside.constraints.0.distance">
      0  2
      1  4
    </track>
    <track target="ring.constraints.0.distance">
      0  2
      1  4
    </track>
    <track target="outside.constraints.0.distance">
      0  2
      1  4
    </track>
  </timeline>
  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
