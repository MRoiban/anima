{
  "anima": "0.1",
  "name": "oracle-data",
  "grid": 20,
  "requires": ["data", "bind", "input"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 8,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "listeners": [
    {
      "on": "gamepad-axis",
      "set": {
        "$value": 9
      },
      "value": "gamepad-axis:0"
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "number"
          },
          "source": {
            "type": "number",
            "default": 4
          }
        }
      }
    }
  }
}
