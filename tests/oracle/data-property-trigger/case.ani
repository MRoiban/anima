{
  "anima": "0.1",
  "name": "oracle-data",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 8,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "listeners": [
    {
      "on": "change:$pulse",
      "set": {
        "$n": 9
      }
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "pulse": {
            "type": "trigger"
          },
          "n": {
            "type": "number"
          }
        }
      }
    }
  }
}
