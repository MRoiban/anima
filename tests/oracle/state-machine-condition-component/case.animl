<anima version="0.1" name="oracle" grid="20" requires="machine components"><component name="badge" grid="20"><number name="count" default="3"/><circle id="c" cx="0" cy="0" r="1" fill="#000" opacity="0"/></component><instance id="child" component="badge"/><rect id="dot" x0="2" y0="8" width="2" height="4" fill="#4263eb"/><timeline name="t0" duration="2"><track target="dot.x">0 0;2 8</track></timeline><timeline name="t1" duration="2"><track target="dot.x">0 8;2 8</track></timeline><timeline name="t2" duration="2"><track target="dot.x">0 4;2 4</track></timeline><layer name="l" initial="a"><state name="a" play="t0" reset="true"><on when="@after(0)" to="b" guard='{"left": {"component": "child.count"}, "op": ">", "right": 2}'/></state><state name="b" play="t1"/></layer></anima>
