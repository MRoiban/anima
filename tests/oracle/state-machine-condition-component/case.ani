{
  "anima": "0.1",
  "name": "oracle",
  "grid": 20,
  "requires": ["machine", "components"],
  "nodes": [
    {
      "id": "child",
      "type": "instance",
      "component": "badge"
    },
    {
      "id": "dot",
      "type": "rect",
      "x0": 2,
      "y0": 8,
      "w": 2,
      "h": 4,
      "fill": {
        "color": "#4263eb"
      }
    }
  ],
  "timelines": {
    "t0": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 0],
          [2, 8]
        ]
      }
    },
    "t1": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 8],
          [2, 8]
        ]
      }
    },
    "t2": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 4],
          [2, 4]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "a",
        "states": {
          "a": {
            "play": "t0",
            "on": [
              {
                "when": "@after(0)",
                "to": "b",
                "guard": {
                  "left": {
                    "component": "child.count"
                  },
                  "right": 2,
                  "op": ">"
                }
              }
            ],
            "reset": true
          },
          "b": {
            "play": "t1"
          }
        }
      }
    }
  },
  "components": {
    "badge": {
      "grid": 20,
      "inputs": {
        "count": {
          "type": "number",
          "default": 3
        }
      },
      "nodes": [
        {
          "id": "c",
          "type": "circle",
          "center": [0, 0],
          "r": 1,
          "opacity": 0,
          "fill": {
            "color": "#000"
          }
        }
      ]
    }
  }
}
