<anima version="0.1" name="rigging-scroll-oracle" grid="20" requires="rig scroll composite">
  <rect id="viewport" x0="0" y0="0" width="10" height="10" fill="#fff"/>
  <group id="content">
    <scroll viewport="viewport" axis="y" offset-y="0" interactive="false"/>
    <clip source="viewport" rule="nonzero"/>
    <rect id="row1" x0="0" y0="0" width="10" height="10" fill="#4263eb"/>
    <rect id="row2" x0="0" y0="10" width="10" height="10" fill="#74c0fc"/>
    <rect id="row3" x0="0" y0="20" width="10" height="10" fill="#ffd43b"/>
  </group>
  <timeline name="drive" duration="1">
    <track target="content.constraints.0.offsetY">0 0; 1 20</track>
  </timeline>
  <layer name="main" initial="drive"><state name="drive" play="drive"/></layer>
</anima>
