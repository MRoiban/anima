{
  "anima": "0.1",
  "name": "trigger-listener-boundary",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "machine": {
    "layers": {
      "m": {
        "initial": "idle",
        "states": {
          "idle": {
            "pose": {},
            "entry": {
              "fire": "$pulse"
            }
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "change:$pulse",
      "set": {
        "$n": 9
      }
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "pulse": {
            "type": "trigger"
          },
          "n": {
            "type": "number"
          }
        }
      }
    }
  }
}
