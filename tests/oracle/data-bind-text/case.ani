{
  "anima": "0.1",
  "name": "data-bind-text",
  "grid": 20,
  "requires": ["text", "data", "assets", "fonts"],
  "nodes": [
    {
      "id": "label",
      "type": "text",
      "width": 8,
      "height": 4,
      "lineHeight": 1,
      "styles": {
        "s": {
          "font": "body",
          "size": 1
        }
      },
      "runs": [
        {
          "text": "$label",
          "style": "s"
        }
      ]
    }
  ],
  "assets": {
    "body": {
      "type": "font",
      "source": "../../../fixtures/fonts/anima-test.ttf"
    }
  },
  "data": {
    "models": {
      "Main": {
        "properties": {
          "label": {
            "type": "string",
            "default": "abcd"
          }
        }
      }
    }
  }
}
