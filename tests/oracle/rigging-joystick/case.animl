<anima version="0.1" name="rigging-joystick" grid="20" requires="posepad">
<rect id="eye" x0="9" y0="9" width="2" height="2" fill="#141413"/>
<group id="handle"/><posepad id="pad" timeline-x="horizontal" timeline-y="vertical"/>
<timeline name="horizontal" duration="2"><track target="eye.x">0 -4; 2 4</track></timeline>
<timeline name="vertical" duration="4"><track target="eye.y">0 -4; 4 4</track></timeline>
<timeline name="drive" duration="1"><track target="pad.value-x">0 -1; 1 1</track><track target="pad.value-y">0 1; 1 -1</track></timeline>
<layer name="l" initial="s"><state name="s" play="drive"/></layer>
</anima>
