<anima version="0.1" name="converter-probe" grid="20" requires="data bind convert" data="{&quot;model&quot;:&quot;Root&quot;}">
  <model name="Item">
    <number name="n" default="0"/>
  </model>
  <model name="Root">
    <list name="value" default="[{},{}]" of="Item"/>
  </model>
  <converter name="cv" type="list-length"/>
  <circle id="dot" cx="10" cy="10" properties="{&quot;result&quot;:{&quot;type&quot;:&quot;number&quot;,&quot;default&quot;:0}}" r="1" fill="#000"/>
  <bind target="dot.properties.result" value="$value" convert="cv"/>
</anima>
