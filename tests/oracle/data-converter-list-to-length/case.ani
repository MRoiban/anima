{
  "anima": "0.1",
  "name": "converter-probe",
  "grid": 20,
  "requires": ["data", "bind", "convert"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      },
      "properties": {
        "result": {
          "type": "number",
          "default": 0
        }
      }
    }
  ],
  "bind": {
    "dot.properties.result": {
      "value": "$value",
      "convert": "cv"
    }
  },
  "data": {
    "models": {
      "Item": {
        "properties": {
          "n": {
            "type": "number",
            "default": 0
          }
        }
      },
      "Root": {
        "properties": {
          "value": {
            "type": "list",
            "default": [
              {},
              {}
            ],
            "of": "Item"
          }
        }
      }
    },
    "model": "Root"
  },
  "converters": {
    "cv": {
      "type": "list-length"
    }
  }
}
