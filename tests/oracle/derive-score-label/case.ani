{
  "anima": "0.1",
  "name": "derive-score-label",
  "grid": 20,
  "requires": ["data", "bind", "derive", "convert"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "data": {
    "models": {
      "Player": {
        "properties": {
          "score": {
            "type": "number",
            "default": 1250
          },
          "label": {
            "type": "string",
            "value": "$score",
            "convert": "points"
          },
          "bounded": {
            "type": "number",
            "min": 10,
            "max": 20,
            "value": "$score / 100"
          }
        }
      }
    }
  },
  "converters": {
    "grouped": {
      "type": "number-format",
      "decimals": 0,
      "grouping": true
    },
    "suffix": {
      "type": "template",
      "text": "{0} pts"
    },
    "points": {
      "chain": ["grouped", "suffix"]
    }
  }
}
