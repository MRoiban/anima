<anima version="0.1" name="derive-score-label" grid="20" requires="data bind derive convert"><model name="Player"><number name="score" default="1250"/><string name="label" value="$score" convert="points"/><number name="bounded" min="10" max="20" value="$score / 100"/></model><converter name="grouped" type="number-format" decimals="0" grouping="true"/><converter name="suffix" type="template" text="{0} pts"/><converter-group name="points" chain="grouped suffix"/><circle id="dot" cx="10" cy="10" r="1" fill="#000"/></anima>
