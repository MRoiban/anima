<anima version="0.1" name="converter-probe" grid="20" requires="data bind convert">
  <model name="Root">
    <number name="value" default="0.126"/>
  </model>
  <converter name="map" type="range" to="0 100"/>
  <converter name="round" type="round"/>
  <converter-group name="cv" chain="map round"/>
  <circle id="dot" cx="10" cy="10" properties="{&quot;result&quot;:{&quot;type&quot;:&quot;number&quot;,&quot;default&quot;:0}}" r="1" fill="#000"/>
  <bind target="dot.properties.result" value="$value" convert="cv"/>
</anima>
