<anima version="0.1" name="text-input-editable" grid="20" requires="text textinput a11y focus data assets fonts">
  <asset name="sans-serif" type="font" src="../../../fixtures/fonts/anima-test.ttf"/>
  <model name="Main">
    <string name="query" default="abcd"/>
  </model>
  <instance name="main" model="Main" default="true"/>
  <text id="field" sizing="fixed" width="10" height="4" line-height="1" x="2" y="3">
    <style id="s" size="1"/>
    <run text="abcd" style="s"/>
    <text-input write-text="$query" label="Field" caret-color="#ff0000" selection-color="#b3d4fc"/>
  </text>
</anima>
