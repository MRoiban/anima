<anima version="0.1" name="rigging-scale" grid="20" requires="rig">
  <group id="target" scaleX="1"/>
  <group id="host" x="10" y="10">
    <copy-scale from="target" factor-x="-1"/>
    <rect id="hostArt" x0="1" y0="0" width="2" height="1" fill="#d97757"/>
  </group>
  <timeline name="go" duration="1">
    <track target="target.scaleX">
      0  1
      1  2
    </track>
  </timeline>
  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
