<anima version="0.1" name="input-keyboard-bubbling" grid="20" requires="input">
  <number name="n"/>

  <group id="parent">
    <circle id="disc" cx="10" cy="10" r="5" fill="#000"/>
  </group>

  <listener on="key-down" target="disc" set="n=1" key="F13"/>
  <listener on="key-down" target="parent" set="n=2"/>
</anima>
