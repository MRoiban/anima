<anima version="0.1" name="bind-logic-and" grid="20" requires="data bind"><model name="Root"><number name="left"/><number name="right"/><bool name="a"/><bool name="b"/></model><circle id="dot" cx="10" cy="10" r="1" fill="#000" properties="{&quot;number&quot;:{&quot;type&quot;:&quot;number&quot;},&quot;bool&quot;:{&quot;type&quot;:&quot;bool&quot;}}"/><bind target="dot.properties.number" value="$a and $b"/><bind target="dot.properties.bool" value="$a and $b"/></anima>
