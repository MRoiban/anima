{
  "anima": "0.1",
  "name": "oracle",
  "grid": 20,
  "requires": ["machine", "bind"],
  "inputs": {
    "level": {
      "type": "number",
      "default": 50
    }
  },
  "nodes": [
    {
      "id": "dot",
      "type": "rect",
      "x0": 2,
      "y0": 8,
      "w": 2,
      "h": 4,
      "fill": {
        "color": "#4263eb"
      }
    }
  ],
  "timelines": {
    "t0": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 0],
          [2, 0]
        ]
      }
    },
    "t1": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 8],
          [2, 8]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "a",
        "states": {
          "a": {
            "play": "t0",
            "mix": {
              "mode": "1d",
              "axis": {
                "bind": "level"
              },
              "children": [
                {
                  "play": "t0",
                  "at": 0
                },
                {
                  "play": "t1",
                  "at": 100
                }
              ]
            }
          }
        }
      }
    }
  }
}
