      "tracks": {
        "dot.x": [
          [0, 0],
          [2, 8]
        ]
      }
    },
    "t1": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 8],
          [2, 8]
        ]
      }
    },
