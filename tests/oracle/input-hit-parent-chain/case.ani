{
  "anima": "0.1",
  "name": "input-hit-parent-chain",
  "grid": 20,
  "requires": ["input"],
  "inputs": {
    "n": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "id": "parent",
      "type": "group",
      "children": [
        {
          "id": "a",
          "type": "circle",
          "center": [10, 10],
          "r": 5,
          "fill": {
            "color": "#4263eb"
          }
        }
      ]
    }
  ],
  "listeners": [
    {
      "on": "down",
      "target": "parent",
      "set": {
        "n": 1
      }
    }
  ]
}
