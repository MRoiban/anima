<anima version="0.1" name="rigging-constraint-strength" grid="20" requires="rig">
  <group id="target" x="14" y="8"/>
  <group id="host" x="4" y="4">
    <copy-position strength="0" from="target"/>
    <rect id="hostArt" x0="-0.5" y0="-0.5" width="1" height="1" fill="#d97757"/>
  </group>
  <timeline name="go" duration="1">
    <track target="host.constraints.0.strength">
      0  0
      1  1
    </track>
  </timeline>
  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
