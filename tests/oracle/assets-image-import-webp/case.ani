{
  "anima": "0.1",
  "name": "assets-image-import-webp",
  "grid": 8,
  "requires": ["paint", "assets"],
  "nodes": [
    {
      "id": "tile",
      "type": "image",
      "x0": 0,
      "y0": 0,
      "asset": "tile",
      "fit": "resize",
      "align": "top-left",
      "sampling": "nearest",
      "wrapX": "clamp",
      "wrapY": "clamp",
      "width": 8,
      "height": 8
    }
  ],
  "assets": {
    "tile": {
      "type": "image",
      "source": "data:image/webp;base64,",
      "width": 2,
      "height": 2
    }
  }
}
