<anima version="0.1" name="assets-image-import-webp" grid="8" requires="paint assets">
  <asset name="tile" type="image"
      src="data:image/webp;base64,"
      width="2" height="2"/>

  <image id="tile" asset="tile" x0="0" y0="0" fit="resize" align="top-left" sampling="nearest" wrap-x="clamp" wrap-y="clamp" width="8" height="8"/>
</anima>
