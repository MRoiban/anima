{
  "anima": "0.1",
  "name": "animation-joystick-handle",
  "grid": 20,
  "requires": ["posepad"],
  "nodes": [
    {
      "id": "eye",
      "type": "rect",
      "x0": 9,
      "y0": 9,
      "w": 2,
      "h": 2,
      "fill": {
        "color": "#141413"
      }
    },
    {
      "id": "handle",
      "type": "group",
      "children": []
    },
    {
      "id": "pad",
      "type": "posepad",
      "timelineX": "horizontal",
      "timelineY": "vertical",
      "handle": "handle",
      "box": [6, 6, 8, 8]
    }
  ],
  "timelines": {
    "horizontal": {
      "duration": 2,
      "tracks": {
        "eye.x": [
          [0, -4],
          [2, 4]
        ]
      }
    },
    "vertical": {
      "duration": 4,
      "tracks": {
        "eye.y": [
          [0, -4],
          [4, 4]
        ]
      }
    },
    "drive": {
      "duration": 1,
      "tracks": {
        "handle.x": [
          [0, 6],
          [1, 14]
        ],
        "handle.y": [
          [0, 14],
          [1, 6]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "s",
        "states": {
          "s": {
            "play": "drive"
          }
        }
      }
    }
  }
}
