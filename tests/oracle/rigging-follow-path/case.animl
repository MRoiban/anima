<anima version="0.1" name="rigging-follow-path-oracle" grid="20" requires="rig pathfollow">
  <path id="curve" d="M3 15C12.5 15 14 5 17 5" opacity="0" stroke="#000"/>
  <path id="closed" d="M3 2.5L7 2.5L7 6.5L3 6.5Z" opacity="0" stroke="#000"/>
  <group id="marker">
    <along-path path="curve" at="0" orient="true"/>
    <rect id="art" x0="-1" y0="-0.5" width="2" height="1" fill="#111827"/>
  </group>
  <group id="wrapped">
    <along-path path="closed" at="1.25" orient="true"/>
    <rect id="wrap-art" x0="-0.5" y0="-0.5" width="1" height="1" fill="#2563eb"/>
  </group>
  <timeline name="drive" duration="1">
    <track target="marker.constraints.0.at">
      0 0
      1 1
    </track>
  </timeline>
  <layer name="main" initial="drive">
    <state name="drive" play="drive"/>
  </layer>
</anima>
