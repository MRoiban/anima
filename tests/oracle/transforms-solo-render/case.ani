{
  "anima": "0.1",
  "name": "transforms-solo",
  "grid": 240,
  "requires": ["input"],
  "inputs": {
    "n": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "id": "parent",
      "type": "group",
      "children": [
        {
          "id": "a",
          "type": "rect",
          "x0": 48,
          "y0": 108,
          "w": 24,
          "h": 24,
          "fill": {
            "color": "#4263eb"
          }
        },
        {
          "id": "b",
          "type": "rect",
          "x0": 168,
          "y0": 108,
          "w": 24,
          "h": 24,
          "fill": {
            "color": "#4263eb"
          }
        }
      ],
      "solo": 1
    }
  ],
  "listeners": [
    {
      "on": "down",
      "target": "a",
      "set": {
        "n": 1
      }
    },
    {
      "on": "down",
      "target": "b",
      "set": {
        "n": 2
      }
    }
  ]
}
