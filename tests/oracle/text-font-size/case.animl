<anima version="0.1" name="text-font-size" grid="20" requires="text assets fonts">
  <asset name="sans-serif" type="font" src="../../../fixtures/fonts/anima-test.ttf"/>
  <text id="label" sizing="fixed" width="4" height="4" line-height="1">
    <style id="s" size="1"/>
    <run id="first" text="ab" style="s"/>
  </text>
  <timeline name="grow" duration="1">
    <track target="label.styles.s.size">0 1; 1 2</track>
    <track target="label.runs.0.text">0 "ab"; 1 "cd"</track>
  </timeline>
  <layer name="main" initial="playing">
    <state name="playing" play="grow"/>
  </layer>
</anima>
