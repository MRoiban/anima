{
  "anima": "0.1",
  "name": "oracle-data",
  "grid": 20,
  "requires": ["data", "bind", "components"],
  "nodes": [
    {
      "id": "a",
      "type": "instance",
      "component": "badge",
      "data": "a"
    },
    {
      "id": "b",
      "type": "instance",
      "component": "badge",
      "data": "b"
    }
  ],
  "components": {
    "badge": {
      "grid": 20,
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [10, 10],
          "r": 1,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "bind": {
        "dot.x": "$g:value"
      },
      "data": "Local"
    }
  },
  "data": {
    "models": {
      "Root": {
        "properties": {}
      },
      "Score": {
        "properties": {
          "value": {
            "type": "number",
            "default": 3
          }
        },
        "global": true
      },
      "Local": {
        "properties": {
          "n": {
            "type": "number"
          }
        }
      }
    },
    "instances": {
      "root": {
        "model": "Root",
        "default": true,
        "values": {}
      },
      "g": {
        "model": "Score",
        "values": {}
      },
      "a": {
        "model": "Local",
        "values": {}
      },
      "b": {
        "model": "Local",
        "values": {}
      }
    }
  }
}
