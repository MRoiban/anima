<anima version="0.1" name="oracle-data" grid="20" requires="data bind components">
  <component name="badge" grid="20" data="Local">
    <circle id="dot" cx="10" cy="10" r="1" fill="#000"/>
    <bind target="dot.x" value="$g:value"/>
  </component>

  <instance id="a" component="badge" data="a"/>
  <instance id="b" component="badge" data="b"/>

  <model name="Root"/>
  <model name="Score" global="true">
    <number name="value" default="3"/>
  </model>
  <model name="Local">
    <number name="n"/>
  </model>
  <instance name="root" model="Root" default="true"/>
  <instance name="g" model="Score"/>
  <instance name="a" model="Local"/>
  <instance name="b" model="Local"/>
</anima>
