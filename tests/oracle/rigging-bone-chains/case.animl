<anima version="0.1" name="rigging-bone-chains" grid="20" requires="rig">
  <bone id="upper" length="5" x="4" y="12">
    <bone id="fore" length="4">
      <rect id="hand" x0="12.5" y0="11.5" width="1" height="1" fill="#d97757"/>
    </bone>
  </bone>
  <timeline name="go" duration="1">
    <track target="upper.rotate">
      0  0
      1  -60
    </track>
    <track target="upper.length">
      0  5
      1  6
    </track>
    <track target="fore.rotate">
      0  0
      1  30
    </track>
  </timeline>
  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
