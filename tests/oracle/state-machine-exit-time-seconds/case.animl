<anima version="0.1" name="state-machine-exit-time-seconds" grid="20" requires="motion"><rect id="a" x0="2" y0="8" width="2" height="4" fill="#4263eb"/><timeline name="t" duration="2"><track target="a.x">0 0;2 8</track></timeline><timeline name="u" duration="1"><track target="a.x">0 0;1 0</track><track target="a.y">0 0;1 4</track></timeline><layer name="l" initial="s"><state name="s" play="t" speed="2"><on when="@after(0)" to="next" exit="1"/></state><state name="next" play="u"/></layer></anima>
