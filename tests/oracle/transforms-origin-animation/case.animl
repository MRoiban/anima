<anima version="0.1" name="transforms-origin-animation" grid="20" requires="motion">
  <circle id="a" cx="0" cy="0" r="1" rotate="90" fill="#000"/>
  <timeline name="t" duration="2">
    <track target="a.pivotX">0 0; 2 4</track>
    <track target="a.pivotY">0 1; 2 3</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
