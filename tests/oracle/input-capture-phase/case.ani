{
  "anima": "0.1",
  "name": "input-capture-phase",
  "grid": 240,
  "requires": ["input"],
  "inputs": {
    "n": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "id": "parent",
      "type": "group",
      "children": [
        {
          "id": "a",
          "type": "rect",
          "x0": 108,
          "y0": 108,
          "w": 24,
          "h": 24,
          "fill": {
            "color": "#4263eb"
          }
        }
      ]
    }
  ],
  "listeners": [
    {
      "on": "down",
      "target": "a",
      "set": {
        "n": 3
      }
    },
    {
      "on": "down",
      "target": "parent",
      "set": {
        "n": 1
      },
      "capture": true,
      "consume": true
    },
    {
      "on": "down",
      "target": "a",
      "set": {
        "n": 2
      },
      "capture": true,
      "consume": true
    }
  ]
}
