<anima version="0.1" name="layout-paint" grid="20" requires="layout">
  <bool name="clicked" default="false"/>
  <layout id="root" width="16" height="10" gap="1" padding="1" x="2" y="2" fill="#f0eee6">
    <rect id="a" x0="0" y0="0" width="2" height="2" fill="#000"/>
    <rect id="b" x0="0" y0="0" width="4" height="3" fill="#000"/>
  </layout>
  <listener on="click" target="root" set="clicked=true"/>
</anima>
