        {
          "id": "icon",
          "type": "group",
          "pivot": [10, 10],
          "children": [
            {
              "id": "art",
              "type": "path",
              "glyph": "art",
              "fill": {
                "color": "currentColor",
                "rule": "evenodd"
              }
            }
          ]
        }
      ],
      "machine": {
        "layers": {
          "press": {
            "initial": "rest",
            "states": {
              "rest": {
                "pose": {
                  "icon.scale": 1
                },
                "on": [
                  {
                    "when": "down",
                    "to": "pressed"
                  },
                  {
                    "when": "hover",
                    "to": "hovered"
                  }
                ]
              },
              "hovered": {
                "pose": {
                  "icon.scale": 1.08
                },
                "on": [
                  {
                    "when": "down",
                    "to": "pressed"
                  },
                  {
                    "when": "!hover",
                    "to": "rest"
                  }
                ]
              },
              "pressed": {
                "pose": {
                  "icon.scale": 0.92
                },
                "on": [
                  {
                    "when": "!down && hover",
                    "to": "hovered"
                  },
                  {
                    "when": "!down && !hover",
                    "to": "rest"
                  }
                ]
              }
            }
          }
        }
      },
      "listeners": [
        {
          "on": "enter",
          "set": {
            "hover": true
          }
        },
        {
          "on": "leave",
          "set": {
            "hover": false,
            "down": false
          }
        },
        {
          "on": "down",
          "set": {
            "down": true
          }
        },
        {
          "on": "up",
          "set": {
            "down": false
          }
        }
      ]
    },
    "badge": {
      "grid": 8,
      "inputs": {
        "count": {
          "type": "number",
          "min": 0,
          "max": 9
        },
        "clear": {
          "type": "trigger"
        }
      },
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [4, 4],
          "r": 3,
          "fill": {
            "color": "#e44"
          }
        }
      ],
      "machine": {
        "layers": {
          "badge": {
            "initial": "unread",
            "states": {
              "unread": {
                "pose": {},
                "on": [
                  {
                    "when": "clear",
                    "to": "cleared"
                  }
                ]
              },
              "cleared": {
                "pose": {
                  "dot.opacity": 0.4
                },
                "emit": "cleared"
              }
            }
          }
        }
      },
      "listeners": [
        {
          "on": "click",
          "fire": "clear"
        }
      ],
      "bind": {
        "dot.r": "min(count, 4)"
      }
    }
  }
}
