  <color name="accent" value="#d9a441"/>
  <bool name="dark" default="false"/>
  <bool name="hover"/>
  <bool name="down"/>
  <a11y role="switch" label="Dark mode" activate="dark" pressed="dark" held="down"/>
  <!-- Keep the glyph geometry intact; separate nodes compose interaction and rotation. -->
  <group id="interaction" pivot="10 10">
    <group id="moon" pivot="10 10">
      <path id="glyph" glyph="moon" fill="ink" fill-rule="evenodd"/>
    </group>
    <circle id="star-a" cx="12" cy="3.5" r="0.45" pivot="12 3.5" scale="0" fill="accent"/>
    <circle id="star-b" cx="16" cy="5" r="0.6" pivot="16 5" scale="0" fill="accent"/>
    <circle id="star-c" cx="17.5" cy="8" r="0.35" pivot="17.5 8" scale="0" fill="accent"/>
  </group>
  <timeline name="nightfall" duration="0.6" reducedMotion="end">
    <track target="moon.rotate">0 0 out; 0.1 -30 out; 0.34 5 inOut; 0.6 0</track>
    <track target="star-a.scale">0 0 hold; 0.12 0 out; 0.27 1.25 inOut; 0.4 1</track>
    <track target="star-b.scale">0 0 hold; 0.2 0 out; 0.35 1.25 inOut; 0.48 1</track>
    <track target="star-c.scale">0 0 hold; 0.28 0 out; 0.43 1.25 inOut; 0.56 1</track>
  </timeline>
  <layer name="mode" initial="light">
    <state name="light">
      <on when="dark" to="dark" blend="0.12" ease="out" interruptible="true"/>
    </state>
    <state name="dark" play="nightfall">
      <on when="!dark" to="light" blend="0.24" ease="inOut" interruptible="true"/>
    </state>
  </layer>
  <layer name="feedback" initial="rest">
    <state name="rest">
      <on when="down" to="pressed" blend="0.08" interruptible="true"/>
      <on when="hover" to="hovered" blend="0.16" interruptible="true"/>
    </state>
    <state name="hovered">
      <pose interaction.scale="1.05"/>
      <on when="down" to="pressed" blend="0.08" interruptible="true"/>
      <on when="!hover" to="rest" blend="0.18" interruptible="true"/>
    </state>
    <state name="pressed">
      <pose interaction.scale="0.95"/>
      <on when="!down and hover" to="hovered" blend="0.14" interruptible="true"/>
      <on when="!down and !hover" to="rest" blend="0.18" interruptible="true"/>
    </state>
  </layer>
  <listener on="click" toggle="dark"/>
  <apply template="ui:press"/>
</anima>
