  <a11y role="button" label="Empty trash" activate="empty" held="down"/>
  <trigger name="empty"/>
  <bool name="hover"/>
  <bool name="down"/>
  <group id="icon" pivot="10 10">
    <path id="original" glyph="trash" fill="ink" fill-rule="evenodd"/>
    <group id="can" pivot="10 17" visible="false">
      <path id="body" glyph="can" fill="ink" fill-rule="evenodd"/>
      <path id="lid" glyph="lid" pivot="16.195 6.496" fill="ink" fill-rule="evenodd"/>
    </group>
  </group>
  <timeline name="hover" duration="0.16" reducedMotion="skip">
    <track target="can.visible">0 false; 0.000001 true</track>
    <track target="original.visible">0 true; 0.000001 false</track>
    <track target="lid.rotate">0 0 out; 0.16 6</track>
    <track target="lid.y">0 0 out; 0.16 -0.35</track>
  </timeline>
  <timeline name="close" duration="0.18" reducedMotion="end">
    <track target="can.visible">0 true; 0.18 false</track>
    <track target="original.visible">0 false; 0.18 true</track>
    <track target="lid.rotate">0 6 out; 0.18 0</track>
    <track target="lid.y">0 -0.35 out; 0.18 0</track>
  </timeline>
  <timeline name="empty" duration="0.9" reducedMotion="end">
    <track target="can.visible">0 true; 0.9 false</track>
    <track target="original.visible">0 false; 0.9 true</track>
    <track target="lid.rotate">0 0 out; 0.18 18 inOut; 0.32 16 inOut; 0.62 -3 out; 0.76 1 out; 0.9 0</track>
    <track target="lid.y">0 0 out; 0.18 -0.1 inOut; 0.32 -0.1 inOut; 0.62 0; 0.9 0</track>
    <track target="can.rotate">0 0; 0.18 0 inOut; 0.26 -3 inOut; 0.34 3 inOut; 0.42 -2 inOut; 0.5 1 out; 0.62 0; 0.9 0</track>
    <track target="can.scaleX">0 1; 0.18 1 out; 0.28 1.04 inOut; 0.42 0.98 out; 0.62 1; 0.9 1</track>
    <track target="can.scaleY">0 1; 0.18 1 out; 0.28 0.94 inOut; 0.42 1.02 out; 0.62 1; 0.9 1</track>
  </timeline>
  <timeline name="press" duration="0.07" reducedMotion="skip">
    <track target="icon.scale">0 1 out; 0.07 0.94</track>
  </timeline>
  <timeline name="release" duration="0.12" reducedMotion="end">
    <track target="icon.scale">0 0.94 out; 0.12 1</track>
  </timeline>
  <layer name="lid" initial="rest">
    <state name="rest">
      <on when="empty" to="empty"/>
      <on when="hover" to="hover"/>
    </state>
    <state name="hover" play="hover">
      <on when="empty" to="empty" blend="0.04"/>
      <on when="!hover" to="close" blend="0.04"/>
    </state>
    <state name="close" play="close">
      <on when="empty" to="empty" blend="0.04"/>
      <on when="hover" to="hover" blend="0.04"/>
      <on when="@end" to="rest"/>
    </state>
    <state name="empty" play="empty">
      <on when="@end" to="closed"/>
    </state>
    <state name="closed">
      <on when="empty" to="empty"/>
      <on when="!hover" to="rest"/>
    </state>
  </layer>
  <layer name="press" initial="rest">
    <state name="rest">
      <on when="down" to="pressed"/>
    </state>
    <state name="pressed" play="press">
      <on when="!down" to="release" blend="0.03"/>
    </state>
    <state name="release" play="release">
      <on when="down" to="pressed" blend="0.03"/>
      <on when="@end" to="rest"/>
    </state>
  </layer>
  <listener on="click" fire="empty"/>
  <apply template="ui:press"/>
</anima>
