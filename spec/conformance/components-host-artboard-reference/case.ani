{
  "anima": "0.1",
  "name": "swappable-card",
  "grid": 20,
  "requires": ["components", "data", "bind", "nested", "host", "dataartboard", "lists"],
  "nodes": [
    {
      "id": "rows",
      "type": "repeat",
      "list": "$items",
      "component": "row",
      "dx": 10
    }
  ],
  "components": {
    "front": {
      "grid": 20,
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [5, 5],
          "r": 1,
          "fill": {
            "color": "#f00"
          }
        }
      ],
      "bind": {
        "dot.r": "$radius"
      }
    },
    "back": {
      "grid": 20,
      "nodes": [
        {
          "id": "box",
          "type": "rect",
          "x0": 1,
          "y0": 1,
          "w": 3,
          "h": 4,
          "fill": {
            "color": "#00f"
          }
        }
      ],
      "bind": {
        "box.w": "$radius + 1"
      }
    },
    "row": {
      "grid": 20,
      "nodes": [
        {
          "id": "body",
          "type": "instance",
          "component": "$content"
        }
      ],
      "data": "Cell"
    }
  },
  "data": {
    "models": {
      "Card": {
        "properties": {
          "items": {
            "type": "list",
            "of": "Cell"
          }
        }
      },
      "Cell": {
        "properties": {
          "content": {
            "type": "artboard",
            "default": "front"
          },
          "radius": {
            "type": "number",
            "default": 2
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Card",
        "default": true,
        "values": {
          "items": [
            {
              "radius": 3
            },
            {
              "radius": 5
            }
          ]
        }
      }
    }
  }
}
