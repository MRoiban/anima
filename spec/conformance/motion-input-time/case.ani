{
  "anima": "0.1",
  "name": "motion-input-time",
  "grid": 20,
  "requires": ["motion", "bind"],
  "inputs": {
    "phase": {
      "type": "number",
      "default": 0.375
    }
  },
  "nodes": [
    {
      "id": "a",
      "type": "circle",
      "center": [0, 0],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "timelines": {
    "t": {
      "duration": 1,
      "tracks": {
        "a.x": [
          [0, 0],
          [1, 8]
        ]
      },
      "events": [
        [0.5, "mid"]
      ],
      "quantize": 4
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "scrub",
        "states": {
          "scrub": {
            "play": "t",
            "time": "phase"
          }
        }
      }
    }
  }
}
