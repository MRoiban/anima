<anima version="0.1" name="state-readonly" grid="20" requires="a11y focus">
  <bool name="flag"/>
  <number name="amount"/>
  <group id="control">
    <a11y role="button" activate="flag" bounds="1 2 3 4"/>
  </group>
  <group id="item">
    <a11y role="slider" value="amount" readonly="flag" bounds="1 2 3 4"/>
  </group>
</anima>
