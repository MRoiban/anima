<anima version="0.1" name="paint-polygon" grid="20" requires="paint">
  <polygon id="a" cx="10" cy="10" sides="5" radius="8" cornerRadius="1" fill="#f00"/>
  <timeline name="t" duration="1">
    <track target="a.cornerRadius">0 1; 1 3</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
