<anima version="0.1" name="converter-probe" grid="20" requires="data bind convert">
  <model name="Root">
    <bool name="value" default="true"/>
  </model>
  <converter name="cv" type="negate"/>
  <circle id="dot" cx="10" cy="10" properties="{&quot;result&quot;:{&quot;type&quot;:&quot;bool&quot;,&quot;default&quot;:false}}" r="1" fill="#000"/>
  <bind target="dot.properties.result" value="$value" convert="cv"/>
</anima>
