<anima version="0.1" name="motion-exit-next-decimal" grid="20" requires="motion">
  <circle id="a" cx="0" cy="0" r="1" fill="#000"/>
  <bool name="syncing" default="true"/>
  <timeline name="t" duration="1.2" loop="loop" quantize="10">
    <track target="a.x">0 0; 1.2 360</track>
  </timeline>
  <layer name="l" initial="spin">
    <state name="spin" play="t">
      <on when="!syncing" to="held" sync="true" exitNext="step"/>
    </state>
    <state name="held" play="t" hold="true"/>
  </layer>
</anima>
