<anima version="0.1" name="paint-star" grid="20" requires="paint">
  <star id="a" cx="10" cy="10" points="5" radius="8" innerRadius="4" cornerRadius="1" fill="#f00"/>
  <timeline name="t" duration="1">
    <track target="a.innerRadius">0 4; 1 2</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
