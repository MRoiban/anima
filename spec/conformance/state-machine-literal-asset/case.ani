{
  "anima": "0.1",
  "name": "state-machine-literal-asset",
  "grid": 20,
  "requires": ["data", "bind", "assets"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "machine": {
    "layers": {
      "status": {
        "initial": "idle",
        "states": {
          "idle": {
            "pose": {
              "dot.r": 1
            },
            "on": [
              {
                "when": "$value == asset(\"photo\")",
                "to": "done"
              }
            ]
          },
          "done": {
            "pose": {
              "dot.r": 9
            }
          }
        }
      }
    }
  },
  "assets": {
    "photo": {
      "type": "image",
      "source": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aOSsAAAAASUVORK5CYII=",
      "width": 1,
      "height": 1
    }
  },
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "asset-ref",
            "assetType": "image"
          }
        }
      }
    }
  }
}
