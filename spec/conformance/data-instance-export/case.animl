<anima version="0.1" name="data-instance-export" grid="20" requires="data">
  <model name="Root">
    <number name="value" default="4"/>
  </model>
  <instance name="public" model="Root" default="true" export="true"/>
  <instance name="private" model="Root"/>
  <circle id="dot" cx="10" cy="10" r="1" fill="#000"/>
</anima>
