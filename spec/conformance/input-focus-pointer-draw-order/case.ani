{
  "anima": "0.1",
  "name": "input-focus-pointer-draw-order",
  "grid": 20,
  "requires": ["input", "focus", "composite", "bind"],
  "inputs": {
    "raised": {
      "type": "bool",
      "default": true
    }
  },
  "nodes": [
    {
      "id": "a",
      "type": "rect",
      "x0": 0,
      "y0": 0,
      "w": 10,
      "h": 10,
      "fill": {
        "color": "#f00"
      },
      "focus": {},
      "drawOrder": {
        "target": "b",
        "position": "after"
      }
    },
    {
      "id": "b",
      "type": "rect",
      "x0": 0,
      "y0": 0,
      "w": 10,
      "h": 10,
      "fill": {
        "color": "#00f"
      },
      "focus": {}
    }
  ],
  "listeners": [
    {
      "on": "focus",
      "target": "a",
      "emit": "a-focus"
    },
    {
      "on": "focus",
      "target": "b",
      "emit": "b-focus"
    }
  ],
  "bind": {
    "a.drawOrder.active": "raised"
  }
}
