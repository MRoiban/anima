{
  "anima": "0.1",
  "name": "players",
  "grid": 30,
  "requires": ["components", "data", "bind", "lists"],
  "nodes": [
    {
      "id": "rows",
      "type": "repeat",
      "list": "$players",
      "component": {
        "Player": "row",
        "Header": "header"
      },
      "dy": 10,
      "size": [30, 10]
    }
  ],
  "components": {
    "row": {
      "grid": 10,
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [2, 2],
          "r": 1,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "bind": {
        "dot.r": "$score",
        "dot.x": "$index",
        "dot.y": "$parent.bonus"
      },
      "data": "Player"
    },
    "header": {
      "grid": 10,
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [2, 2],
          "r": 1,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "bind": {
        "dot.r": "$score"
      },
      "data": "Header"
    }
  },
  "data": {
    "models": {
      "Player": {
        "properties": {
          "score": {
            "type": "number"
          }
        }
      },
      "Board": {
        "properties": {
          "bonus": {
            "type": "number",
            "default": 2
          },
          "players": {
            "type": "list"
          }
        }
      },
      "Header": {
        "properties": {
          "score": {
            "type": "number"
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Board",
        "default": true,
        "values": {
          "players": [
            {
              "model": "Player",
              "values": {
                "score": 3
              }
            },
            {
              "model": "Player",
              "values": {
                "score": 7
              }
            },
            {
              "model": "Header",
              "values": {
                "score": 9
              }
            }
          ]
        }
      }
    }
  }
}
