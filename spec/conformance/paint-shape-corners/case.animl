<anima version="0.1" name="paint-corners" grid="20" requires="paint">
  <rect id="a" x0="2" y0="2" corners="1 2 0 3" width="16" height="16" fill="#f00"/>
  <timeline name="t" duration="1">
    <track target="a.corners.0">0 1; 1 3</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
