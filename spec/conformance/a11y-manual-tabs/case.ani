{
  "anima": "0.1",
  "name": "manual-tabs",
  "grid": 24,
  "viewBox": [0, 0, 24, 7],
  "requires": ["a11y", "focus", "input"],
  "inputs": {
    "first": {
      "type": "bool"
    },
    "second": {
      "type": "bool"
    }
  },
  "nodes": [
    {
      "id": "tabs",
      "type": "group",
      "children": [
        {
          "id": "day",
          "type": "rect",
          "x0": 0,
          "y0": 0,
          "w": 12,
          "h": 7,
          "fill": {
            "color": "#123456"
          },
          "a11y": {
            "role": "tab",
            "label": "Day",
            "activate": "first",
            "selected": "first"
          }
        },
        {
          "id": "week",
          "type": "rect",
          "x0": 12,
          "y0": 0,
          "w": 12,
          "h": 7,
          "fill": {
            "color": "#123456"
          },
          "a11y": {
            "role": "tab",
            "label": "Week",
            "activate": "second",
            "selected": "second"
          }
        }
      ],
      "a11y": {
        "role": "tab-list",
        "label": "View"
      }
    }
  ]
}
