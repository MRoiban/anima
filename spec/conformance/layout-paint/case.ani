{
  "anima": "0.1",
  "name": "layout-paint",
  "grid": 20,
  "requires": ["layout"],
  "inputs": {
    "clicked": {
      "type": "bool",
      "default": false
    }
  },
  "nodes": [
    {
      "id": "root",
      "type": "layout",
      "x": 2,
      "y": 2,
      "fill": {
        "color": "#f0eee6"
      },
      "children": [
        {
          "id": "a",
          "type": "rect",
          "x0": 0,
          "y0": 0,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#000"
          }
        },
        {
          "id": "b",
          "type": "rect",
          "x0": 0,
          "y0": 0,
          "w": 4,
          "h": 3,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "width": 16,
      "height": 10,
      "gap": [1],
      "padding": [1]
    }
  ],
  "listeners": [
    {
      "on": "click",
      "target": "root",
      "set": {
        "clicked": true
      }
    }
  ]
}
