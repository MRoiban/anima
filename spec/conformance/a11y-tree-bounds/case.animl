<anima version="0.1" name="semantic-bounds" grid="100" requires="a11y paint">
  <group id="panel" x="10" y="20">
    <a11y role="group" label="Panel"/>
    <rect id="box" x0="2" y0="3" width="4" height="5" fill="#000">
      <a11y role="img" label="Box"/>
    </rect>
    <group id="offset" x="-5" y="2">
      <rect id="paint" x0="1" y0="1" width="2" height="2" fill="#000"/>
    </group>
  </group>
  <group id="explicit" x="40">
    <a11y role="group" label="Explicit" bounds="0 0 1 1"/>
    <rect id="outside" x0="20" y0="20" width="2" height="2" fill="#000"/>
  </group>
  <group id="empty" x="50" y="60">
    <a11y role="text" label="Point"/>
  </group>
  <circle id="stroked" cx="80" cy="80" r="2" stroke="#000" stroke-width="2">
    <a11y role="img" label="Stroke"/>
  </circle>
  <path id="curve" d="M0 0C0 12 12 12 12 0" x="80" y="50" fill="#000">
    <a11y role="img" label="Cubic"/>
  </path>
</anima>
