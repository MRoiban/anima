{
  "anima": "0.1",
  "name": "semantic-bounds",
  "grid": 100,
  "requires": ["a11y"],
  "nodes": [
    {
      "id": "panel",
      "type": "group",
      "x": 10,
      "y": 20,
      "children": [
        {
          "id": "box",
          "type": "rect",
          "x0": 2,
          "y0": 3,
          "w": 4,
          "h": 5,
          "fill": {
            "color": "#000"
          },
          "a11y": {
            "role": "img",
            "label": "Box"
          }
        },
        {
          "id": "offset",
          "type": "group",
          "x": -5,
          "y": 2,
          "children": [
            {
              "id": "paint",
              "type": "rect",
              "x0": 1,
              "y0": 1,
              "w": 2,
              "h": 2,
              "fill": {
                "color": "#000"
              }
            }
          ]
        }
      ],
      "a11y": {
        "role": "group",
        "label": "Panel"
      }
    },
    {
      "id": "explicit",
      "type": "group",
      "x": 40,
      "children": [
        {
          "id": "outside",
          "type": "rect",
          "x0": 20,
          "y0": 20,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "a11y": {
        "role": "group",
        "label": "Explicit",
        "bounds": [0, 0, 1, 1]
      }
    },
    {
      "id": "empty",
      "type": "group",
      "x": 50,
      "y": 60,
      "children": [],
      "a11y": {
        "role": "text",
        "label": "Point"
      }
    }
  ]
}
