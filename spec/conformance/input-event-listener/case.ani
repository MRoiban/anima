{
  "anima": "0.1",
  "name": "events",
  "grid": 20,
  "requires": ["events"],
  "inputs": {
    "n": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "id": "a",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "machine": {
    "layers": {
      "main": {
        "initial": "s",
        "states": {
          "s": {
            "pose": {},
            "emit": "ping"
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "event:ping",
      "set": {
        "n": 9
      }
    }
  ],
  "eventDefs": {
    "ping": {
      "payload": {
        "n": {
          "type": "number",
          "input": "n"
        }
      }
    }
  }
}
