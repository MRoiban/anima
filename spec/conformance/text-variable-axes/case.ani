{
  "anima": "0.1",
  "name": "text-variable-axes",
  "grid": 20,
  "requires": ["text", "fonts", "bind", "assets"],
  "inputs": {
    "weight": {
      "type": "number",
      "default": 400,
      "min": 100,
      "max": 900
    }
  },
  "nodes": [
    {
      "id": "label",
      "type": "text",
      "lineHeight": 1,
      "styles": {
        "s": {
          "font": "body",
          "size": 2,
          "axes": {
            "wght": 400
          }
        }
      },
      "runs": [
        {
          "text": "AV",
          "style": "s"
        }
      ]
    }
  ],
  "bind": {
    "label.styles.s.axes.wght": "weight"
  },
  "assets": {
    "body": {
      "type": "font",
      "source": "../../../fixtures/fonts/anima-test.ttf"
    }
  }
}
