<anima version="0.1" name="properties-data" grid="20" requires="a11y focus data">
  <model name="M">
    <string name="title" default="Before"/>
    <string name="help" default="Help"/>
    <string name="text" default="Value"/>
    <number name="depth" default="2" min="1" max="6"/>
  </model>
  <instance name="main" model="M" default="true"/>
  <group id="item">
    <a11y role="heading" label="$title" hint="$help" value="$text" level="&quot;$depth&quot;" bounds="1 2 3 4"/>
  </group>
</anima>
