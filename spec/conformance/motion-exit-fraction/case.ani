{
  "anima": "0.1",
  "name": "motion-exit-fraction",
  "grid": 20,
  "requires": ["motion"],
  "nodes": [
    {
      "id": "a",
      "type": "circle",
      "center": [0, 0],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "timelines": {
    "t": {
      "duration": 2,
      "tracks": {
        "a.x": [
          [0, 0],
          [2, 20]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "first",
        "states": {
          "first": {
            "play": "t",
            "speed": 2,
            "on": [
              {
                "when": "@after(0)",
                "to": "next",
                "exitFraction": 0.5
              }
            ]
          },
          "next": {
            "play": "t"
          }
        }
      }
    }
  }
}
