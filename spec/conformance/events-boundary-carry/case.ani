{
  "anima": "0.1",
  "name": "events-boundary-carry",
  "grid": 20,
  "requires": ["events"],
  "nodes": [
    {
      "id": "a",
      "type": "circle",
      "center": [0, 0],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "machine": {
    "layers": {
      "l": {
        "initial": "s",
        "states": {
          "s": {
            "pose": {
              "a.x": 0
            },
            "on": [
              {
                "when": "@after(0.25)",
                "to": "done",
                "blend": 0.25,
                "startEmit": "begin",
                "endEmit": "ended"
              }
            ],
            "endEmit": "exit"
          },
          "done": {
            "pose": {
              "a.x": 10
            },
            "emit": "entry"
          }
        }
      }
    }
  }
}
