{
  "anima": "0.1",
  "name": "assets-host-decode-font",
  "grid": 20,
  "requires": ["text", "data", "bind", "assets", "fonts"],
  "nodes": [
    {
      "id": "label",
      "type": "text",
      "sizing": "auto-width",
      "lineHeight": 1,
      "styles": {
        "s": {
          "font": "body",
          "size": 2
        }
      },
      "runs": [
        {
          "text": "abcd",
          "style": "s"
        }
      ]
    }
  ],
  "bind": {
    "label.styles.s.font": "$face"
  },
  "assets": {
    "body": {
      "type": "font",
      "source": "../../../fixtures/fonts/anima-test.ttf"
    },
    "alternate": {
      "type": "font",
      "source": "../../../fixtures/fonts/anima-test.ttf"
    }
  },
  "data": {
    "models": {
      "Main": {
        "properties": {
          "face": {
            "type": "asset-ref",
            "default": "body",
            "assetType": "font"
          }
        }
      }
    }
  }
}
