{
  "anima": "0.1",
  "name": "components-library-models",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [5, 5],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "bind": {
    "dot.r": "$import-3-main:score"
  },
  "data": {
    "models": {
      "import-2-Person": {
        "properties": {
          "score": {
            "type": "number",
            "default": 3
          },
          "mood": {
            "type": "enum",
            "default": "busy",
            "enum": "import-1-Mood"
          }
        }
      }
    },
    "instances": {
      "import-3-main": {
        "model": "import-2-Person",
        "default": true,
        "values": {
          "score": 7
        }
      }
    },
    "enums": {
      "import-1-Mood": ["calm", "busy"]
    }
  }
}
