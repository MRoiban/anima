<anima version="0.1" name="interpolate-probe" grid="20" requires="data bind convert">
  <model name="Root">
    <number name="value" default="0"/>
  </model>
  <converter name="smooth" type="interpolate" ease="linear" duration="100"/>
  <circle id="dot" cx="10" cy="10" properties="{&quot;result&quot;:{&quot;type&quot;:&quot;number&quot;,&quot;default&quot;:0}}" r="1" fill="#000"/>
  <bind target="dot.properties.result" value="$value" mode="two-way" convert="smooth"/>
</anima>
