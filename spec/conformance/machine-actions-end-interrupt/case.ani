{
  "anima": "0.1",
  "name": "machine-probe",
  "grid": 20,
  "requires": ["machine"],
  "inputs": {
    "go": {
      "type": "trigger"
    },
    "flag": {
      "type": "bool"
    },
    "stop": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#4263eb"
      }
    }
  ],
  "machine": {
    "layers": {
      "l": {
        "initial": "a",
        "states": {
          "a": {
            "pose": {
              "dot.x": 0
            },
            "on": [
              {
                "when": "go",
                "to": "b",
                "blend": 1,
                "endActions": {
                  "set": {
                    "flag": true
                  },
                  "emit": "transition-end-actions"
                }
              }
            ]
          },
          "b": {
            "pose": {
              "dot.x": 10
            },
            "on": [
              {
                "when": "stop",
                "to": "c"
              }
            ]
          },
          "c": {
            "pose": {
              "dot.x": 20
            }
          }
        }
      }
    }
  }
}
