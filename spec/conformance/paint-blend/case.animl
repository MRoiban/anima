<anima version="0.1" name="paint-blend" grid="20" requires="paint">
  <rect id="a" x0="0" y0="0" mix-blend-mode="screen" width="20" height="20" fill="#f00"/>
  <timeline name="t" duration="1">
    <track target="a.x">0 0; 1 2</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
