<anima version="0.1" name="text-font-metrics" grid="20" requires="text fonts assets bind">
  <asset name="body" type="font" src="../../../fixtures/fonts/anima-test.ttf"/>
  <number name="option" default="2"/>
  <text id="label" line-height="1">
    <style id="s" font="body" size="2"/>
    <run text="AB" style="s"/>
  </text>
  <bind target="label.styles.s.size" value="option"/>
</anima>
