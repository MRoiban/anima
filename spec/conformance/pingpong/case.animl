<!-- Pingpong playback reverses at each endpoint and reports endpoint events once per crossing. -->
<anima version="0.1" name="case" grid="20">
  <circle id="a" cx="10" cy="10" r="5" pivot="10 10" fill="#000"/>

  <timeline name="t" duration="1" loop="pingpong">
    <track target="a.y">0 0; 1 10</track>
    <event at="1" name="turn"/>
    <event at="0" name="start"/>
  </timeline>

  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
