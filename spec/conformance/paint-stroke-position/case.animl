<anima version="0.1" name="paint-stroke-position" grid="20" requires="composite">
  <rect id="a" x0="2" y0="2" width="16" height="16" fill="#fff" stroke="#000" stroke-width="2" stroke-position="inside"/>
  <timeline name="t" duration="1">
    <track target="a.x">0 0; 1 2</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
