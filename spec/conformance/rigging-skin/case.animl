<anima version="0.1" name="rigging-skin" grid="30" requires="paint contour assets mesh rig skin">
  <asset name="pixel" type="image"
      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4AWP4z8DwHwAFgAI/ScLJ0QAAAABJRU5ErkJggg=="
      width="1" height="1"/>

  <bone id="arm" length="10"/>
  <path id="path" d="M0 0L10 0" skin="{&quot;bones&quot;:[&quot;arm&quot;],&quot;weights&quot;:[{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}}]}" stroke="#000"/>
  <contour id="contour"
      vertices="[{&quot;point&quot;:[0,2],&quot;kind&quot;:&quot;straight&quot;},{&quot;point&quot;:[10,2],&quot;kind&quot;:&quot;straight&quot;},{&quot;point&quot;:[10,4],&quot;kind&quot;:&quot;straight&quot;},{&quot;point&quot;:[0,4],&quot;kind&quot;:&quot;straight&quot;}]"
      closed="true"
      skin="{&quot;bones&quot;:[&quot;arm&quot;],&quot;weights&quot;:[{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}}]}"
      fill="#000"/>
  <image id="mesh" asset="pixel" x0="0" y0="6"
      mesh="{&quot;vertices&quot;:[[0,6,0,0],[10,6,1,0],[10,8,1,1],[0,8,0,1]],&quot;triangles&quot;:[[0,1,2],[0,2,3]]}"
      skin="{&quot;bones&quot;:[&quot;arm&quot;],&quot;weights&quot;:[{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}},{&quot;point&quot;:{&quot;arm&quot;:1}}]}"
      width="10" height="2"/>

  <timeline name="bend" duration="1">
    <track target="arm.rotate">
      0  0
      1  90
    </track>
  </timeline>

  <layer name="main" initial="bend">
    <state name="bend" play="bend"/>
  </layer>
</anima>
