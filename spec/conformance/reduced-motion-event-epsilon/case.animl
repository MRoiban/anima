<!-- An event recognised within ε before the clock (§5) is not reported again when reduced motion
     then freezes its timeline at the end. -->
<anima version="0.1" name="case" grid="20">
  <circle id="a" cx="10" cy="10" r="5" fill="#000"/>

  <timeline name="t" duration="1" reducedMotion="end">
    <track target="a.x">0 0; 1 10</track>
    <event at="0.5" name="mid"/>
  </timeline>

  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
