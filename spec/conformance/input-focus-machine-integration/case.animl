<anima version="0.1" name="focus-machine" grid="20" requires="focus input machine">
  <number name="n"/>

  <circle id="a" cx="2" cy="2" r="1" fill="#000">
    <focus bounds="1 1 2 2"/>
  </circle>
  <circle id="b" cx="8" cy="2" r="1" fill="#000">
    <focus bounds="7 1 2 2"/>
  </circle>
  <circle id="hidden" cx="14" cy="2" r="1" collapsed="true" fill="#000">
    <focus bounds="13 1 2 2"/>
  </circle>

  <layer name="l" initial="a">
    <state name="a">
      <pose a.x="0"/>
      <on when="@after(0)" to="b" guard="{&quot;left&quot;:{&quot;focus&quot;:&quot;b&quot;},&quot;right&quot;:true,&quot;op&quot;:&quot;==&quot;}"/>
    </state>
    <state name="b">
      <pose a.x="1"/>
      <on when="@after(0)" to="a" guard="{&quot;left&quot;:{&quot;focus&quot;:&quot;b&quot;},&quot;right&quot;:false,&quot;op&quot;:&quot;==&quot;}"/>
    </state>
  </layer>

  <listener on="focus" target="hidden" set="n=1"/>
</anima>
