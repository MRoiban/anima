{
  "anima": "0.1",
  "name": "machine-probe",
  "grid": 20,
  "requires": ["machine"],
  "inputs": {
    "go": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#4263eb"
      }
    }
  ],
  "timelines": {
    "t0": {
      "duration": 2,
      "reducedMotion": "end",
      "tracks": {
        "dot.x": [
          [0, 0],
          [2, 8]
        ]
      }
    },
    "t1": {
      "duration": 2,
      "reducedMotion": "play",
      "tracks": {
        "dot.x": [
          [0, 8],
          [2, 16]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "idle",
        "states": {
          "a": {
            "play": "t0",
            "mix": {
              "mode": "direct",
              "children": [
                {
                  "play": "t0",
                  "at": 0,
                  "weight": 0.25
                },
                {
                  "play": "t1",
                  "at": 1,
                  "weight": 0.75
                }
              ]
            }
          },
          "idle": {
            "pose": {
              "dot.x": 0
            },
            "on": [
              {
                "when": "go",
                "to": "a"
              }
            ]
          }
        }
      }
    }
  }
}
