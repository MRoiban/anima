{
  "anima": "0.1",
  "name": "layout-image-intrinsic",
  "grid": 20,
  "requires": ["layout", "assets", "paint"],
  "nodes": [
    {
      "id": "root",
      "type": "layout",
      "children": [
        {
          "id": "image",
          "type": "image",
          "x0": 0,
          "y0": 0,
          "asset": "pixel",
          "width": 3,
          "height": 4,
          "layout": {
            "width": "hug",
            "height": "hug"
          }
        }
      ],
      "width": "hug",
      "height": "hug",
      "padding": [1]
    }
  ],
  "assets": {
    "pixel": {
      "type": "image",
      "source": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='3'%20height='4'%3E%3Crect%20width='3'%20height='4'%20fill='black'/%3E%3C/svg%3E"
    }
  }
}
