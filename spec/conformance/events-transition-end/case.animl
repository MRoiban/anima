<anima version="0.1" name="events" grid="20" requires="events">
  <trigger name="go"/>

  <circle id="a" cx="10" cy="10" r="1" fill="#000"/>

  <event-def name="done" payload="{&quot;ok&quot;:{&quot;type&quot;:&quot;bool&quot;,&quot;value&quot;:true}}"/>

  <layer name="main" initial="s">
    <state name="s" endEmit="exit">
      <pose/>
      <on when="go" to="end" blend="0.25" startEmit="begin" endEmit="done"/>
    </state>
    <state name="end" emit="ping">
      <pose/>
    </state>
  </layer>
</anima>
