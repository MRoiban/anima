{
  "anima": "0.1",
  "name": "motion-exit-next-loop-reverse",
  "grid": 20,
  "requires": ["motion"],
  "inputs": {
    "stop": {
      "type": "bool"
    }
  },
  "nodes": [
    {
      "id": "a",
      "type": "circle",
      "center": [0, 0],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "timelines": {
    "t": {
      "duration": 1,
      "loop": "loop",
      "tracks": {
        "a.x": [
          [0, 0],
          [1, 8]
        ]
      },
      "speed": -2,
      "work": [0.25, 0.75]
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "spin",
        "states": {
          "spin": {
            "play": "t",
            "on": [
              {
                "when": "stop",
                "to": "held",
                "sync": true,
                "exitNext": "loop"
              }
            ]
          },
          "held": {
            "play": "t",
            "hold": true
          }
        }
      }
    }
  }
}
