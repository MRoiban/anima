<anima version="0.1" name="data-bind-keyframes-blend" grid="20" requires="data motion">
  <trigger name="go"/>
  <model name="Levels">
    <number name="peak" default="8"/>
  </model>
  <circle id="probe" cx="10" cy="10" r="1" fill="#000"/>
  <timeline name="rise" duration="1">
    <track target="probe.r">
      <key t="0" value="0"/>
      <key t="1" value="$peak"/>
    </track>
  </timeline>
  <layer name="main" initial="idle">
    <state name="idle">
      <pose probe.r="1"/>
      <on when="go" to="run" blend="0.5"/>
    </state>
    <state name="run" play="rise"/>
  </layer>
</anima>
