{
  "anima": "0.1",
  "name": "share",
  "grid": 20,
  "requires": ["events", "assets", "bind"],
  "colors": {
    "ink": "#141413",
    "accent": "#d97757"
  },
  "a11y": {
    "role": "button",
    "label": "Share"
  },
  "inputs": {
    "count": {
      "type": "number",
      "default": 0
    },
    "pulse": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "links",
      "type": "path",
      "d": "M5 10L15 5M5 10L15 15",
      "stroke": {
        "color": "ink",
        "width": 1.5
      }
    },
    {
      "id": "left",
      "type": "circle",
      "center": [5, 10],
      "r": 2,
      "pivot": [5, 10],
      "fill": {
        "color": "ink"
      }
    },
    {
      "id": "upper",
      "type": "circle",
      "center": [15, 5],
      "r": 2,
      "pivot": [15, 5],
      "fill": {
        "color": "ink"
      }
    },
    {
      "id": "lower",
      "type": "circle",
      "center": [15, 15],
      "r": 2,
      "pivot": [15, 15],
      "fill": {
        "color": "ink"
      }
    }
  ],
  "timelines": {
    "pulse": {
      "duration": 0.4,
      "loop": "once",
      "tracks": {
        "left.scale": [
          [0, 1],
          [0.15, 1.3],
          [0.3, 1],
          [0.4, 1]
        ],
        "upper.scale": [
          [0, 1],
          [0.05, 1],
          [0.2, 1.3],
          [0.35, 1],
          [0.4, 1]
        ],
        "lower.scale": [
          [0, 1],
          [0.1, 1],
          [0.25, 1.3],
          [0.4, 1]
        ]
      },
      "events": [
        [0, "shared"],
        [0.4, "pulse-done"]
      ]
    }
  },
  "machine": {
    "layers": {
      "motion": {
        "initial": "rest",
        "states": {
          "rest": {
            "pose": {},
            "on": [
              {
                "when": "pulse && count > 0 && mod(count, 5) == 0",
                "to": "fifth"
              },
              {
                "when": "pulse",
                "to": "playing"
              }
            ]
          },
          "playing": {
            "play": "pulse",
            "on": [
              {
                "when": "pulse && count > 0 && mod(count, 5) == 0",
                "to": "fifth"
              },
              {
                "when": "pulse",
                "to": "playing"
              },
              {
                "when": "@end",
                "to": "rest"
              }
            ]
          },
          "fifth": {
            "play": "pulse",
            "emit": "milestone",
            "on": [
              {
                "when": "pulse && count > 0 && mod(count, 5) == 0",
                "to": "fifth"
              },
              {
                "when": "pulse",
                "to": "playing"
              },
              {
                "when": "@end",
                "to": "rest"
              }
            ]
          }
        }
      }
    }
  },
  "listeners": [
    {
      "on": "click",
      "fire": "pulse",
      "set": {
        "count": "count+1"
      }
    }
  ],
  "assets": {
    "tone": {
      "type": "audio",
      "source": "share-tone.wav"
    }
  },
  "eventDefs": {
    "shared": {
      "payload": {
        "count": {
          "type": "number",
          "value": "{count}"
        },
        "channel": {
          "type": "string",
          "value": "button"
        }
      },
      "audio": "tone"
    },
    "milestone": {
      "url": "https://example.org/thanks",
      "target": "_blank"
    }
  }
}
