<anima version="0.1" name="share" grid="20" requires="events assets bind">
  <color name="ink" value="#141413"/>
  <color name="accent" value="#d97757"/>
  <number name="count" default="0"/>
  <trigger name="pulse"/>
  <a11y role="button" label="Share"/>
  <asset name="tone" type="audio" src="share-tone.wav"/>
  <event-def name="shared"
      payload="{&quot;count&quot;:{&quot;type&quot;:&quot;number&quot;,&quot;value&quot;:&quot;{count}&quot;},&quot;channel&quot;:{&quot;type&quot;:&quot;string&quot;,&quot;value&quot;:&quot;button&quot;}}"
      audio="tone"/>
  <event-def name="milestone" url="https://example.org/thanks" target="_blank"/>
  <path id="links" d="M5 10L15 5M5 10L15 15" stroke="ink" stroke-width="1.5"/>
  <circle id="left" cx="5" cy="10" r="2" pivot="5 10" fill="ink"/>
  <circle id="upper" cx="15" cy="5" r="2" pivot="15 5" fill="ink"/>
  <circle id="lower" cx="15" cy="15" r="2" pivot="15 15" fill="ink"/>
  <timeline name="pulse" duration="0.4" loop="once">
    <track target="left.scale">0 1; 0.15 1.3; 0.3 1; 0.4 1</track>
    <track target="upper.scale">0 1; 0.05 1; 0.2 1.3; 0.35 1; 0.4 1</track>
    <track target="lower.scale">0 1; 0.1 1; 0.25 1.3; 0.4 1</track>
    <event at="0" name="shared"/>
    <event at="0.4" name="pulse-done"/>
  </timeline>
  <layer name="motion" initial="rest">
    <state name="rest">
      <on when="pulse and count > 0 and mod(count, 5) == 0" to="fifth"/>
      <on when="pulse" to="playing"/>
    </state>
    <state name="playing" play="pulse">
      <on when="pulse and count > 0 and mod(count, 5) == 0" to="fifth"/>
      <on when="pulse" to="playing"/>
      <on when="@end" to="rest"/>
    </state>
    <state name="fifth" play="pulse" emit="milestone">
      <on when="pulse and count > 0 and mod(count, 5) == 0" to="fifth"/>
      <on when="pulse" to="playing"/>
      <on when="@end" to="rest"/>
    </state>
  </layer>
  <listener on="click" fire="pulse" set="count=count+1"/>
</anima>
