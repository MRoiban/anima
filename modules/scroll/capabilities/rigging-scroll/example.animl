<anima version="0.1" name="rigging-scroll" grid="20" requires="rig input scroll">
  <rect id="viewport" x0="0" y0="0" width="10" height="10" fill="#e9ecef"/>
  <group id="content">
    <scroll viewport="viewport" axis="y" offset-y="4" interactive="true"/>
    <rect id="body" x0="0" y0="0" width="10" height="30" fill="#4263eb"/>
  </group>
  <rect id="track" x0="12" y0="0" width="2" height="10" fill="#ced4da"/>
  <rect id="thumb" x0="12" y0="0" width="2" height="2" fill="#343a40">
    <scroll-thumb scroll="content" track="track" axis="y" resize="true"/>
  </rect>
</anima>
