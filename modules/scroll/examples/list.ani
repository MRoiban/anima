{
  "anima": "0.1",
  "name": "scroll-list",
  "grid": 20,
  "requires": ["rig", "input", "scroll", "composite"],
  "nodes": [
    {
      "id": "viewport",
      "type": "rect",
      "x0": 2,
      "y0": 2,
      "w": 12,
      "h": 12,
      "fill": {
        "color": "#eef1f5"
      }
    },
    {
      "id": "content",
      "type": "group",
      "x": 2,
      "y": 2,
      "children": [
        {
          "id": "row1",
          "type": "rect",
          "x0": 0,
          "y0": 0,
          "w": 12,
          "h": 4,
          "fill": {
            "color": "#4263eb"
          }
        },
        {
          "id": "row2",
          "type": "rect",
          "x0": 0,
          "y0": 5,
          "w": 12,
          "h": 4,
          "fill": {
            "color": "#748ffc"
          }
        },
        {
          "id": "row3",
          "type": "rect",
          "x0": 0,
          "y0": 10,
          "w": 12,
          "h": 4,
          "fill": {
            "color": "#91a7ff"
          }
        },
        {
          "id": "row4",
          "type": "rect",
          "x0": 0,
          "y0": 15,
          "w": 12,
          "h": 4,
          "fill": {
            "color": "#bac8ff"
          }
        }
      ],
      "constraints": [
        {
          "kind": "scroll",
          "viewport": "viewport",
          "axis": "y",
          "offsetY": 3,
          "interactive": true
        }
      ],
      "clip": {
        "source": "viewport",
        "rule": "nonzero"
      }
    },
    {
      "id": "track",
      "type": "rect",
      "x0": 15,
      "y0": 2,
      "w": 1,
      "h": 12,
      "fill": {
        "color": "#ced4da"
      }
    },
    {
      "id": "thumb",
      "type": "rect",
      "x0": 15,
      "y0": 2,
      "w": 1,
      "h": 2,
      "fill": {
        "color": "#495057"
      },
      "constraints": [
        {
          "kind": "scrollThumb",
          "scroll": "content",
          "track": "track",
          "axis": "y",
          "resize": true
        }
      ]
    }
  ]
}
