<anima version="0.1" name="look" grid="20" requires="posepad bind input">
  <number name="knobX" default="10"/>
  <number name="knobY" default="15"/>
  <circle id="leftEye" cx="6" cy="6" r="3" fill="#eee"/>
  <circle id="rightEye" cx="14" cy="6" r="3" fill="#eee"/>
  <group id="pupils">
    <circle id="leftPupil" cx="6" cy="6" r="1" fill="#141413"/>
    <circle id="rightPupil" cx="14" cy="6" r="1" fill="#141413"/>
  </group>
  <rect id="rail" x0="6" y0="11" width="8" height="8" stroke="#888"/>
  <circle id="knob" cx="0" cy="0" r="1" fill="#d97757"/>
  <bind target="knob.x" value="knobX"/>
  <bind target="knob.y" value="knobY"/>
  <listener on="drag-start|drag|drag-end" target="knob" write="{&quot;x&quot;:&quot;knobX&quot;,&quot;y&quot;:&quot;knobY&quot;}" align="preserve"/>
  <posepad id="look" timeline-x="across" timeline-y="vertical" handle="knob" box="6 11 8 8"/>
  <timeline name="across" duration="2">
    <track target="pupils.x">0 -1.5; 2 1.5</track>
  </timeline>
  <timeline name="vertical" duration="4">
    <track target="pupils.y">0 -1.5; 4 1.5</track>
  </timeline>
</anima>
