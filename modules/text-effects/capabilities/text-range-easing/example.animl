<anima version="0.1" name="text-range-easing" grid="20" requires="text texteffects">
  <text id="label">
    <style id="s" size="1"/>
    <run id="first" text="ab " style="s"/>
    <run id="last" text="cd" style="s"/>
    <text-effect start="2" end="3" falloff="2" ease="in" opacity="0"/>
  </text>
</anima>
