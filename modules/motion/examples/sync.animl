<anima version="0.1" name="sync" title="Sync" grid="20" requires="motion bind">
  <color name="ink" value="#141413"/>
  <color name="accent" value="#d97757"/>
  <bool name="syncing"/>
  <bool name="hover"/>
  <number name="phase" default="0" min="0" max="1"/>
  <a11y role="button" label="Sync" activate="syncing" pressed="syncing"/>
  <hit rect="0 0 20 20"/>
  <group id="peek" pivot="10 10">
    <group id="arrows" pivot="10 10">
      <arc id="top" cx="10" cy="10" r="6" from="-165" to="-15" stroke="ink" stroke-width="1.5" stroke-linecap="round"/>
      <path id="top-tip" d="M14.064 7.447L15.796 8.447L16.796 6.715" stroke="ink" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <arc id="bottom" cx="10" cy="10" r="6" from="15" to="165" stroke="ink" stroke-width="1.5" stroke-linecap="round"/>
      <path id="bottom-tip" d="M5.936 12.553L4.204 11.553L3.204 13.285" stroke="ink" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </group>
  </group>
  <path id="check" d="M7 10L9.2 12.2L13 8" pivot="10 10" scale="0" stroke="accent" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <timeline name="turn" duration="1.2" loop="loop" reducedMotion="skip" quantize="10">
    <track target="arrows.rotate">0 0; 1.2 360</track>
  </timeline>
  <timeline name="pop" duration="0.6" reducedMotion="end">
    <track target="check.scale">0 0 elastic(1, 0.3); 0.6 1</track>
  </timeline>
  <timeline name="peek-motion" duration="0.4" reducedMotion="end">
    <track target="peek.scale">0 1; 0.4 1.1</track>
  </timeline>
  <layer name="hover" initial="rest">
    <state name="rest" play="peek-motion" hold="true">
      <on when="hover" to="forward" sync="true"/>
    </state>
    <state name="forward" play="peek-motion">
      <on when="!hover" to="reverse" sync="true"/>
    </state>
    <state name="reverse" play="peek-motion" speed="-1">
      <on when="hover" to="forward" sync="true"/>
    </state>
  </layer>
  <listener on="enter" set="hover=true"/>
  <listener on="leave" set="hover=false"/>
  <layer name="rotation" initial="idle">
    <state name="idle" play="turn" time="phase * 1.2">
      <on when="syncing" to="spin"/>
    </state>
    <state name="spin" play="turn">
      <on when="!syncing" to="idle" sync="true" exitNext="step"/>
    </state>
  </layer>
  <!-- The completion clock uses the same phase and step grid as rotation. -->
  <timeline name="wait" duration="1.2" loop="loop" reducedMotion="skip" quantize="10">
    <track target="check.scale">0 0; 1.2 0</track>
  </timeline>
  <layer name="completion" initial="idle">
    <state name="idle" play="wait" time="phase * 1.2">
      <on when="syncing" to="running"/>
    </state>
    <state name="running" play="wait">
      <on when="!syncing" to="done" exitNext="step"/>
    </state>
    <state name="done" play="pop">
      <on when="syncing" to="running"/>
    </state>
  </layer>
</anima>
