{
  "anima": "0.1",
  "name": "search-card",
  "grid": 20,
  "requires": ["text", "textinput", "a11y", "focus", "data", "bind", "derive", "convert", "input"],
  "nodes": [
    {
      "id": "search",
      "type": "text",
      "x": 1,
      "y": 1,
      "sizing": "fixed",
      "width": 18,
      "height": 2,
      "runs": [
        {
          "text": "",
          "style": "body"
        }
      ],
      "textInput": {
        "placeholder": "Exact label…",
        "writeText": "$query",
        "label": "Search fruit",
        "selectionRadius": 0.1
      }
    },
    {
      "id": "item0",
      "type": "text",
      "x": 1,
      "y": 4,
      "runs": [
        {
          "text": "$items.0.label",
          "style": "body"
        }
      ]
    },
    {
      "id": "item1",
      "type": "text",
      "x": 1,
      "y": 6,
      "runs": [
        {
          "text": "$items.1.label",
          "style": "body"
        }
      ]
    },
    {
      "id": "item2",
      "type": "text",
      "x": 1,
      "y": 8,
      "runs": [
        {
          "text": "$items.2.label",
          "style": "body"
        }
      ]
    },
    {
      "id": "item3",
      "type": "text",
      "x": 1,
      "y": 10,
      "runs": [
        {
          "text": "$items.3.label",
          "style": "body"
        }
      ]
    },
    {
      "id": "item4",
      "type": "text",
      "x": 1,
      "y": 12,
      "runs": [
        {
          "text": "$items.4.label",
          "style": "body"
        }
      ]
    },
    {
      "id": "count",
      "type": "text",
      "x": 1,
      "y": 16,
      "runs": [
        {
          "text": "$summary",
          "style": "body"
        }
      ]
    }
  ],
  "bind": {
    "item0.collapsed": "$show0 == 0",
    "item1.collapsed": "$show1 == 0",
    "item2.collapsed": "$show2 == 0",
    "item3.collapsed": "$show3 == 0",
    "item4.collapsed": "$show4 == 0"
  },
  "data": {
    "models": {
      "Item": {
        "properties": {
          "label": {
            "type": "string"
          }
        }
      },
      "Search": {
        "properties": {
          "query": {
            "type": "string"
          },
          "items": {
            "type": "list",
            "of": "Item"
          },
          "show0": {
            "type": "number",
            "value": "$query == \"\" or $query == $items.0.label"
          },
          "show1": {
            "type": "number",
            "value": "$query == \"\" or $query == $items.1.label"
          },
          "show2": {
            "type": "number",
            "value": "$query == \"\" or $query == $items.2.label"
          },
          "show3": {
            "type": "number",
            "value": "$query == \"\" or $query == $items.3.label"
          },
          "show4": {
            "type": "number",
            "value": "$query == \"\" or $query == $items.4.label"
          },
          "count": {
            "type": "number",
            "value": "$show0 + $show1 + $show2 + $show3 + $show4"
          },
          "summary": {
            "type": "string",
            "value": "$count",
            "convert": "results"
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Search",
        "default": true,
        "values": {
          "items": [
            {
              "label": "Apple"
            },
            {
              "label": "Pear"
            },
            {
              "label": "Plum"
            },
            {
              "label": "Peach"
            },
            {
              "label": "Orange"
            }
          ]
        }
      }
    }
  },
  "converters": {
    "results": {
      "type": "template",
      "text": "{0} results"
    }
  },
  "textStyles": {
    "body": {
      "size": 1
    }
  }
}
