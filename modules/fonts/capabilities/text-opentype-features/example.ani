{
  "anima": "0.1",
  "name": "text-opentype-features",
  "grid": 20,
  "requires": ["assets", "fonts"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "assets": {
    "body": {
      "type": "font",
      "source": "data:font/ttf;base64,"
    }
  }
}
