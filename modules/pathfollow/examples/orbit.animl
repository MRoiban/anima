<anima version="0.1" name="pathfollow-orbit" grid="48" requires="rig pathfollow">
  <path id="ride" d="M5 11C12 2 28 2 35 11" stroke="#6b7280" stroke-width="0.8"/>
  <group id="rider">
    <along-path path="ride" at="0.42" orient="true"/>
    <rect id="arrow" x0="-1.5" y0="-0.6" width="3" height="1.2" rx="0.3" fill="#111827"/>
  </group>

  <arc id="beadPath" cx="20" cy="31" r="10" from="200" to="340" stroke="#9ca3af" stroke-width="0.8"/>
  <group id="beads">
    <spread-along-path path="beadPath" start="0" end="1" orient="true"/>
    <rect id="bead1" x0="-0.8" y0="-0.8" width="1.6" height="1.6" rx="0.3" fill="#111827"/>
    <rect id="bead2" x0="-0.8" y0="-0.8" width="1.6" height="1.6" rx="0.3" fill="#111827"/>
    <rect id="bead3" x0="-0.8" y0="-0.8" width="1.6" height="1.6" rx="0.3" fill="#111827"/>
    <rect id="bead4" x0="-0.8" y0="-0.8" width="1.6" height="1.6" rx="0.3" fill="#111827"/>
    <rect id="bead5" x0="-0.8" y0="-0.8" width="1.6" height="1.6" rx="0.3" fill="#111827"/>
  </group>
</anima>
