{
  "anima": "0.1",
  "name": "data-bind-layout",
  "grid": 20,
  "requires": ["layout", "data", "bind"],
  "nodes": [
    {
      "id": "root",
      "type": "layout",
      "x": 2,
      "y": 2,
      "children": [
        {
          "id": "a",
          "type": "rect",
          "x0": 0,
          "y0": 0,
          "w": 2,
          "h": 2,
          "fill": {
            "color": "#000"
          },
          "layout": {
            "width": 2
          }
        },
        {
          "id": "b",
          "type": "rect",
          "x0": 0,
          "y0": 0,
          "w": 4,
          "h": 3,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "width": 16,
      "height": 10,
      "gap": [1],
      "padding": [1]
    }
  ],
  "bind": {
    "a.layout.width": "$size"
  },
  "data": {
    "models": {
      "Main": {
        "properties": {
          "size": {
            "type": "number",
            "default": 2
          }
        }
      }
    }
  }
}
