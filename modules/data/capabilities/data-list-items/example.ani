{
  "anima": "0.1",
  "name": "data-probe",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "team": {
            "type": "model-ref",
            "model": "Team"
          },
          "items": {
            "type": "list",
            "of": "Team"
          }
        }
      },
      "Team": {
        "properties": {
          "title": {
            "type": "string",
            "default": "Blue"
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Root",
        "default": true,
        "values": {
          "team": "blue",
          "items": ["blue"]
        }
      },
      "blue": {
        "model": "Team",
        "values": {}
      }
    }
  }
}
