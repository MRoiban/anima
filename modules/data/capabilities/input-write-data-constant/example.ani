{
  "anima": "0.1",
  "name": "data-probe",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "listeners": [
    {
      "on": "click",
      "set": {
        "$b": 9
      }
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "a": {
            "type": "number",
            "default": 4
          },
          "b": {
            "type": "number",
            "default": 2
          }
        }
      }
    }
  }
}
