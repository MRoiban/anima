{
  "anima": "0.1",
  "name": "data-probe",
  "grid": 20,
  "requires": ["data", "bind"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "machine": {
    "layers": {
      "m": {
        "initial": "idle",
        "states": {
          "idle": {
            "pose": {},
            "on": [
              {
                "when": "$value > 3",
                "to": "done"
              }
            ]
          },
          "done": {
            "pose": {
              "dot.x": 9
            }
          }
        }
      }
    }
  },
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "number",
            "default": 4
          }
        }
      }
    }
  }
}
