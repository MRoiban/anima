<anima version="0.1" name="data-probe" grid="20" requires="data bind">
  <circle id="dot" cx="10" cy="10" properties="{&quot;custom&quot;:{&quot;type&quot;:&quot;enum&quot;,&quot;values&quot;:[&quot;calm&quot;,&quot;happy&quot;],&quot;default&quot;:&quot;happy&quot;}}" r="1" fill="#000"/>

  <model name="Root">
    <enum name="value" default="calm" values="calm happy"/>
  </model>

  <bind target="dot.properties.custom" value="$value"/>
</anima>
