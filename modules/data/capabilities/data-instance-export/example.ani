{
  "anima": "0.1",
  "name": "data-instance-export",
  "grid": 20,
  "requires": ["data"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "number",
            "default": 4
          }
        }
      }
    },
    "instances": {
      "public": {
        "model": "Root",
        "default": true,
        "exported": true,
        "values": {}
      },
      "private": {
        "model": "Root",
        "values": {}
      }
    }
  }
}
