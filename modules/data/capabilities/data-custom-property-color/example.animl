<anima version="0.1" name="data-probe" grid="20" requires="data bind">
  <circle id="dot" cx="10" cy="10" properties="{&quot;custom&quot;:{&quot;type&quot;:&quot;color&quot;,&quot;default&quot;:&quot;#000&quot;}}" r="1" fill="#000"/>

  <model name="Root">
    <color name="value" default="#11223344"/>
  </model>

  <bind target="dot.properties.custom" value="$value"/>
</anima>
