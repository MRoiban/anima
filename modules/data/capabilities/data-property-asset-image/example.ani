{
  "anima": "0.1",
  "name": "data-probe",
  "grid": 20,
  "requires": ["data", "bind", "assets"],
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "assets": {
    "first": {
      "type": "image",
      "source": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR42mO4WR4OAAPUAahSxzpbAAAAAElFTkSuQmCC"
    },
    "second": {
      "type": "image",
      "source": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR42mMIL78JAALQAagz8EUKAAAAAElFTkSuQmCC"
    }
  },
  "data": {
    "models": {
      "Root": {
        "properties": {
          "value": {
            "type": "asset-ref",
            "default": "first",
            "assetType": "image"
          }
        }
      }
    }
  }
}
