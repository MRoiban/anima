<anima version="0.1" name="rigging-constraint-order" grid="20" requires="rig">
  <group id="ab" x="0" y="0">
    <copy-position from="a"/>
    <copy-position from="b"/>
    <circle id="abArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
  </group>
  <group id="ba" x="0" y="0">
    <copy-position from="b"/>
    <copy-position from="a"/>
    <circle id="baArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
  </group>
  <group id="a" x="4" y="2">
    <circle id="aArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
  </group>
  <group id="b" x="10" y="6">
    <circle id="bArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
  </group>

  <timeline name="go" duration="1">
    <track target="a.x">
      0  4
      1  6
    </track>
    <track target="b.y">
      0  6
      1  8
    </track>
  </timeline>

  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
