<anima version="0.1" name="rigging-scale" grid="20" requires="rig">
  <group id="sourceParent" scale="2">
    <group id="target" x="0" y="0" scaleX="2" scaleY="3">
      <circle id="targetArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
    </group>
  </group>
  <group id="hostParent" scale="3">
    <group id="local" x="0" y="0" scaleY="2">
      <copy-scale from="target" from-space="local" to-space="local" factor-x="-1" copy-y="false" min-x="-4" max-x="-1"/>
      <circle id="localArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
    </group>
    <group id="world" x="0" y="0">
      <copy-scale from="target" factor-y="-1" min-y="-5"/>
      <circle id="worldArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
    </group>
    <group id="limited" x="0" y="0">
      <copy-scale from="target" limit-space="local" max-x="1"/>
      <circle id="limitedArt" cx="0" cy="0" r="0.35" fill="#d97757"/>
    </group>
  </group>

  <timeline name="go" duration="1">
    <track target="target.scaleX">
      0  2
      1  3
    </track>
  </timeline>

  <layer name="main" initial="go">
    <state name="go" play="go"/>
  </layer>
</anima>
