<anima version="0.1" name="input-pointer-drag-end" grid="20" requires="input">
  <bool name="active"/>

  <rect id="a" x0="2" y0="8" width="4" height="4" fill="#4263eb"/>

  <layer name="main" initial="idle">
    <state name="idle">
      <pose a.x="0"/>
      <on when="active" to="active"/>
    </state>
    <state name="active">
      <pose a.x="8"/>
    </state>
  </layer>

  <listener on="drag-end" target="a" set="active=true"/>
</anima>
