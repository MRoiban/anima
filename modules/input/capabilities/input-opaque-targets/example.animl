<anima version="0.1" name="input-opaque-targets" grid="20" requires="input">
  <number name="n"/>

  <circle id="disc" cx="10" cy="10" r="5" fill="#000"/>
  <circle id="top" cx="10" cy="10" opaque="true" r="5" fill="#000"/>

  <listener on="down" target="disc" write="{&quot;pointerId&quot;:&quot;n&quot;}"/>
</anima>
