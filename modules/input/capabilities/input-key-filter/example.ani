{
  "anima": "0.1",
  "name": "input-key-filter",
  "grid": 20,
  "requires": ["input"],
  "inputs": {
    "n": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "id": "disc",
      "type": "circle",
      "center": [10, 10],
      "r": 5,
      "fill": {
        "color": "#000"
      }
    }
  ],
  "listeners": [
    {
      "on": "key-down",
      "target": "disc",
      "set": {
        "n": 1
      },
      "key": "F13"
    }
  ]
}
