{
  "anima": "0.1",
  "name": "players",
  "grid": 30,
  "requires": ["components", "data", "bind", "lists"],
  "nodes": [
    {
      "id": "rows",
      "type": "repeat",
      "count": "$n",
      "component": "row",
      "dy": 10,
      "size": [30, 10]
    }
  ],
  "components": {
    "row": {
      "grid": 10,
      "inputs": {
        "go": {
          "type": "trigger"
        }
      },
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [2, 2],
          "r": 1,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "machine": {
        "layers": {
          "selection": {
            "initial": "idle",
            "states": {
              "idle": {
                "pose": {},
                "on": [
                  {
                    "when": "go",
                    "to": "selected"
                  }
                ]
              },
              "selected": {
                "pose": {
                  "dot.scale": 0.5
                }
              }
            }
          }
        }
      },
      "bind": {
        "dot.r": "$score",
        "dot.x": "$index",
        "dot.y": "$parent.bonus"
      },
      "data": "Player"
    }
  },
  "data": {
    "models": {
      "Player": {
        "properties": {
          "score": {
            "type": "number"
          }
        }
      },
      "Board": {
        "properties": {
          "bonus": {
            "type": "number",
            "default": 2
          },
          "players": {
            "type": "list",
            "of": "Player"
          },
          "n": {
            "type": "number",
            "default": 2
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Board",
        "default": true,
        "values": {
          "players": [
            {
              "score": 3
            },
            {
              "score": 7
            }
          ]
        }
      }
    }
  }
}
