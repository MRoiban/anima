{
  "anima": "0.1",
  "name": "players",
  "grid": 30,
  "requires": [
    "components",
    "data",
    "bind",
    "lists"
  ],
  "nodes": [
    {
      "id": "one",
      "type": "instance",
      "component": "row",
      "data": "$bonus"
    }
  ],
  "components": {
    "row": {
      "grid": 10,
      "nodes": [
        {
          "id": "dot",
          "type": "circle",
          "center": [
            2,
            2
          ],
          "r": 1,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "bind": {
        "dot.r": "$score",
        "dot.x": "$index",
        "dot.y": "$parent.bonus"
      },
      "data": "Player"
    }
  },
  "data": {
    "models": {
      "Player": {
        "properties": {
          "score": {
            "type": "number"
          }
        }
      },
      "Board": {
        "properties": {
          "bonus": {
            "type": "number",
            "default": 2
          },
          "players": {
            "type": "list",
            "of": "Player"
          }
        }
      }
    },
    "instances": {
      "main": {
        "model": "Board",
        "default": true,
        "values": {
          "players": [
            {
              "score": 3
            },
            {
              "score": 7
            }
          ]
        }
      }
    }
  }
}
