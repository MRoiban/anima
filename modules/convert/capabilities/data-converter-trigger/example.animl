<anima version="0.1" name="data-converter-trigger" grid="20" requires="data bind convert">
  <model name="Root">
    <number name="value"/>
    <trigger name="pulse"/>
  </model>
  <converter name="pulse" type="trigger"/>
  <circle id="dot" cx="10" cy="10" r="1" fill="#000"/>
  <bind target="$pulse" value="$value" convert="pulse"/>
  <layer name="status" initial="idle">
    <state name="idle">
      <pose dot.r="1"/>
      <on when="$pulse" to="first"/>
    </state>
    <state name="first">
      <pose dot.r="9"/>
      <on when="$pulse" to="second"/>
    </state>
    <state name="second">
      <pose dot.r="18"/>
    </state>
  </layer>
</anima>
