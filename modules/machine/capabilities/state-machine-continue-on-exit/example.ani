{
  "anima": "0.1",
  "name": "machine-probe",
  "grid": 20,
  "requires": ["machine"],
  "inputs": {
    "go": {
      "type": "trigger"
    }
  },
  "nodes": [
    {
      "id": "dot",
      "type": "circle",
      "center": [10, 10],
      "r": 1,
      "fill": {
        "color": "#4263eb"
      }
    }
  ],
  "timelines": {
    "t": {
      "duration": 2,
      "tracks": {
        "dot.x": [
          [0, 0],
          [2, 10]
        ]
      }
    }
  },
  "machine": {
    "layers": {
      "l": {
        "initial": "a",
        "states": {
          "a": {
            "play": "t",
            "on": [
              {
                "when": "go",
                "to": "b",
                "blend": 1,
                "continue": true
              }
            ]
          },
          "b": {
            "pose": {
              "dot.x": 10
            }
          }
        }
      }
    }
  }
}
