<anima version="0.1" name="machine-probe" grid="20" requires="machine">
  <circle id="dot" cx="10" cy="10" r="1" fill="#4263eb"/>

  <timeline name="t0" duration="2">
    <track target="dot.x">
      0  0
      2  0
    </track>
  </timeline>
  <timeline name="t1" duration="1">
    <track target="dot.x">
      0  10
      1  10
    </track>
  </timeline>

  <layer name="l" initial="a">
    <state name="a" play="t1" mix="{&quot;mode&quot;:&quot;direct&quot;,&quot;exit&quot;:1,&quot;children&quot;:[{&quot;play&quot;:&quot;t0&quot;},{&quot;play&quot;:&quot;t1&quot;}]}">
      <on when="@end" to="b"/>
    </state>
    <state name="b">
      <pose dot.x="20"/>
    </state>
  </layer>
</anima>
