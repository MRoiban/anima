{
  "anima": "0.1",
  "name": "machine-probe",
  "grid": 20,
  "requires": [
    "components"
  ],
  "inputs": {},
  "nodes": [
    {
      "type": "circle",
      "id": "dot",
      "center": [
        10,
        10
      ],
      "r": 1,
      "fill": {
        "color": "#4263eb"
      }
    },
    {
      "type": "instance",
      "id": "child",
      "component": "badge"
    }
  ],
  "timelines": {},
  "machine": {
    "layers": {
      "l": {
        "initial": "a",
        "states": {
          "a": {
            "pose": {
              "dot.x": 0
            },
            "on": [
              {
                "when": "@after(0)",
                "to": "b",
                "guard": {
                  "left": {
                    "component": "child.count"
                  },
                  "op": ">",
                  "right": 2
                }
              }
            ]
          },
          "b": {
            "pose": {
              "dot.x": 10
            }
          }
        }
      }
    }
  },
  "components": {
    "badge": {
      "grid": 20,
      "nodes": [
        {
          "type": "circle",
          "id": "c",
          "center": [
            0,
            0
          ],
          "r": 1,
          "fill": {
            "color": "#000"
          }
        }
      ],
      "inputs": {
        "count": {
          "type": "number",
          "default": 3
        }
      }
    }
  }
}
