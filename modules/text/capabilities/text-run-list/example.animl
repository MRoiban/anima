<anima version="0.1" name="text-run-list" grid="20" requires="text data"
    data="{&quot;models&quot;: {&quot;Main&quot;: {&quot;properties&quot;: {&quot;label&quot;: {&quot;type&quot;: &quot;string&quot;, &quot;default&quot;: &quot;abcd&quot;}, &quot;style&quot;: {&quot;type&quot;: &quot;text-style&quot;, &quot;default&quot;: &quot;shared&quot;}, &quot;items&quot;: {&quot;type&quot;: &quot;list&quot;, &quot;of&quot;: &quot;Item&quot;, &quot;default&quot;: [{&quot;label&quot;: &quot;abcd&quot;}]}}}, &quot;Item&quot;: {&quot;properties&quot;: {&quot;label&quot;: {&quot;type&quot;: &quot;string&quot;}}}}}">
  <text-style id="shared" size="1"/>
  <text id="label" runs="$items" sizing="fixed" text-field="label" width="4" height="4">
    <style id="s" size="1"/>
  </text>
</anima>
