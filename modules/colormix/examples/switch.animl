<anima version="0.1" name="switch" grid="20" requires="colormix">
  <color name="off" value="#000"/>
  <color name="on" value="#fff"/>
  <rect id="track" x0="1" y0="5" width="18" height="10" rx="5">
    <colorMix a="off" b="on" t="0"/>
  </rect>
  <timeline name="t" duration="1">
    <track target="track.fill.mix.t">0 0; 1 1</track>
  </timeline>
  <layer name="l" initial="s">
    <state name="s" play="t"/>
  </layer>
</anima>
