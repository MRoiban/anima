<anima version="0.1" name="inferred-text" grid="100" requires="assets fonts text a11y">
  <asset name="sans-serif" type="font"
      src="data:font/ttf;base64,"/>
  <group id="container" x="10" y="20">
    <a11y role="group"/>
    <text id="label">
      <a11y role="text"/>
      <style id="s" size="10"/>
      <run text="AB" style="s"/>
      <run text="C" style="s"/>
    </text>
  </group>
</anima>
