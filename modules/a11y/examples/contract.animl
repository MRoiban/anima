<anima version="0.1" name="semantic-contract" grid="20" requires="a11y focus">
  <bool name="checked"/>
  <bool name="mixed" default="true"/>
  <bool name="hidden"/>
  <number name="volume" default="40"/>
  <group id="settings">
    <a11y role="group" label="Settings" bounds="0 0 20 20"/>
    <rect id="mute" x0="1" y0="2" width="3" height="4" fill="#000">
      <a11y role="checkbox" label="Mute" checked="checked" hidden="hidden" checked-mixed="mixed" bounds="1 2 3 4"/>
    </rect>
    <rect id="volume" x0="5" y0="6" width="7" height="8" fill="#000">
      <a11y role="slider" label="Volume" value="volume" min="0" max="100" step="5" bounds="5 6 7 8"/>
    </rect>
  </group>
</anima>
